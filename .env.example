# Copy to .env and adjust. Values are resolved relative to the repo root.
# Generated automatically by deploy/bootstrap.ps1 / bootstrap.sh.

OPENCODE_HARNESS_ROOT=C:/path/to/opencode_harness_portable
PYTHON_BIN=C:/path/to/.venv/Scripts/python.exe
WRITER_PYTHON=C:/path/to/.venv/Scripts/python.exe
OPENCODE_CONFIG_DIR=C:/path/to/.opencode

# Optional: real OpenCode session DB (for doc_guard).
# OPENCODE_SESSION_DB=C:/Users/<you>/.local/share/opencode/opencode.db
# DOC_GUARD_CONFIG=C:/path/to/guard_config.json