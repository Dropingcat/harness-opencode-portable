# --- Harness portable module: ignore machine-specific / build artifacts ---

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node
node_modules/
dist/
*.tgz

# Build / runtime state
.runs/
run/
artifacts/
audit_graph/

# Environment
.env
.env.local

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# OpenCode session data (machine-specific)
opencode.db*

# Nested .opencode inside scripts/research (machine-local, node_modules etc.)
scripts/research/.opencode/

# Server copy-duplicates "[1]" and lock files (machine-local artifacts)
*[1].json
*[1].md
*[1].txt
*[1].jsonl
*.lock.mcp.mcp.json.bak

# OpenCode config backups
.opencode/*.bak
