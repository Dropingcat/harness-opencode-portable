      "on_budget_exhaustion": "BLOCKED"
    },
    "strict": {
      "description": "High-risk research/security/critical integration work.",
      "guard_mode": "mandatory_p0_p2_fail_closed",
      "guard_degradation": {
        "allowed": [],
        "forbidden": [
          "p0_only",
          "warn_only"
        ],
        "reason_code_on_degrade": "POLICY_GUARD_P2_REQUIRED"
      },
      "preferred_execution_mode": "worker_reviewer_tester_auditor",
      "max_iterations": 5,
      "budget_multiplier": 1.5,
      "tribunal_required": true,
      "human_review_required": true,
      "on_budget_exhaustion": "PARTIAL"
    }
  },
  "execution_modes": {
    "noagents_or_single": {
      "agents": [],
      "description": "NoAgents or one bounded worker path.",
      "use_when_profiles": [
        "soft"
      ]
    },
    "worker_reviewer_tester": {
      "agents": [
        "coder-worker",
        "code-reviewer",
        "code-tester"
      ],
      "description": "Default code execution loop.",
      "use_when_profiles": [
        "standard"
      ]
    },
    "worker_reviewer_tester_auditor": {
      "agents": [
        "coder-worker",
        "code-reviewer",
        "code-tester",
        "code-auditor"
      ],
      "description": "Strict execution loop with tribunal capability.",
      "use_when_profiles": [
        "strict"
      ]
    },
    "research_pipeline": {
      "agents": [
        "claim-parser",
        "source-fetcher",
        "fact-checker",
        "synthesizer"
      ],
      "description": "Research claim/evidence loop.",
      "use_when_profiles": [
        "standard",
        "strict"
      ]
    }
  },
