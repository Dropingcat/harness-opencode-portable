        "evidence-validation":{"skills":["scientific-critical-thinking"],"tools":["evidence.verify","job.checkpoint"],"required_capabilities":["evidence.verify","job.checkpoint"],"optional_capabilities":[],"next":["synthesis"]},
        "synthesis":{"skills":["conducting-scientific-research"],"tools":["report.compose","job.checkpoint"],"required_capabilities":["report.compose","job.checkpoint"],"optional_capabilities":["plot.render"],"next":[]}
      }
