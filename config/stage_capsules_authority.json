        "document-analysis":{"skills":["scientific-critical-thinking","physics-verification"],"tools":["document.inspect","corpus.search","job.checkpoint"],"required_capabilities":["document.text.extract","job.checkpoint"],"optional_capabilities":["document.structured.inspect","document.ocr","office.docx.inspect","office.xlsx.inspect","image.tiff.inspect","science.numeric","science.symbolic","formula.validate"],"escalation":{"document.ocr":["no_text_layer","low_text_density"],"image.tiff.inspect":["scientific_image_input"]},"next":["evidence-validation"]},
        "evidence-validation":{"skills":["scientific-critical-thinking","citation-management"],"tools":["evidence.verify","science.compute","job.checkpoint"],"required_capabilities":["evidence.verify","job.checkpoint"],"optional_capabilities":["science.numeric","science.symbolic","formula.validate"],"next":["synthesis"]},
        "synthesis":{"skills":["conducting-scientific-research","scientific-critical-thinking"],"tools":["report.compose","plot.render","job.checkpoint"],"required_capabilities":["report.compose","job.checkpoint"],"optional_capabilities":["plot.render"],"next":[]}
      }
    },
