        "benchmark":{"skills":["autoresearch","verification-planning"],"tools":["code.test","science.compute","plot.render","job.checkpoint"],"required_capabilities":["code.test","job.checkpoint"],"optional_capabilities":["science.numeric","plot.render"],"next":["experiment"]},
        "experiment":{"skills":["autoresearch","incremental-implementation"],"tools":["code.change","code.test","science.compute","plot.render","job.checkpoint"],"required_capabilities":["code.edit","code.test","job.checkpoint"],"optional_capabilities":["science.numeric","plot.render"],"next":["review"]},
        "review":{"skills":["code-review-and-quality"],"tools":["code.review","code.acceptance","job.checkpoint"],"required_capabilities":["code.review","code.acceptance","job.checkpoint"],"optional_capabilities":[],"forbidden_capabilities":["code.edit"],"next":[]}
