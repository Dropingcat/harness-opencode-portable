        "change":{"skills":["incremental-implementation","code-factory"],"tools":["code.change","job.checkpoint"],"required_capabilities":["code.edit","job.checkpoint"],"optional_capabilities":[],"next":["review"]},
        "review":{"skills":["code-review-and-quality"],"tools":["code.review","code.acceptance","job.checkpoint"],"required_capabilities":["code.review","code.acceptance","job.checkpoint"],"forbidden_capabilities":["code.edit"],"next":[]}
