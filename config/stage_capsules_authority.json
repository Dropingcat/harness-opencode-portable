  "domain_overlays": {
    "mathematics":{"match_regex":"(equation|formula|derive|integral|matrix|optimization|уравнен|формул|интеграл|матриц|математ)","skills":["verification-planning"],"capabilities":["science.numeric","science.symbolic","formula.validate"],"tools":["science.compute"]},
    "physics":{"match_regex":"(physics|mechanics|quantum|diffraction|xrd|oscillator|физик|механик|квант|дифрак|рентген|осцилл)","skills":["physics-verification","scientific-critical-thinking"],"capabilities":["science.physics","science.numeric","science.symbolic","formula.validate","plot.render"],"tools":["science.compute","plot.render"]},
    "chemistry":{"match_regex":"(chemistry|chemical|molar|stoichiometry|reaction|хими|моляр|стехиометр|реакц)","skills":["scientific-critical-thinking"],"capabilities":["science.chemistry","science.numeric","formula.validate"],"tools":["science.compute"]},
    "reporting":{"match_regex":"(report|table|chart|figure|plot|отчет|отчёт|таблиц|график|рисунок)","skills":["export"],"capabilities":["report.compose","plot.render"],"tools":["report.compose","plot.render"]},
    "office-data":{"match_regex":"(docx|doc|xlsx|xls|word|excel|ворд|эксел)","skills":["markitdown"],"capabilities":["document.structured.inspect","office.docx.inspect","office.xlsx.inspect","office.legacy.inspect"],"tools":["document.inspect"]},
    "scientific-image":{"match_regex":"(tiff|tif|sem|eds|microscopy|микроскоп|спектр|тифф)","skills":["scientific-critical-thinking"],"capabilities":["image.tiff.inspect","plot.render"],"tools":["scientific_image.inspect","plot.render"]}
