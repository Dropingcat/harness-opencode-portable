{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://harness.local/schema/harness-bridge-rpc/1.0",
  "title": "HarnessBridgeRPC",
  "description": "Line-delimited JSON-RPC over child-process stdio. Full duplex. Protocol harness-bridge-rpc/1.0.",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "method", "params"],
  "properties": {
    "id": { "type": ["string", "number"] },
    "method": {
      "type": "string",
      "enum": [
        "bridge.hello",
        "bridge.health",
        "bridge.shutdown",
        "bridge.reverse_echo_test",
        "harness.status",
        "harness.run",
        "harness.cancel",
        "semantic.execute"
      ]
    },
    "params": { "type": "object" }
  }
}