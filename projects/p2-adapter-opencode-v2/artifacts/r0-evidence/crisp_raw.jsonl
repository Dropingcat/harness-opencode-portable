": false, "providerState": {"itemId": "fc_0f05ab37e548106a016ace69eb609887d2a176023f0957b696"}, "state": {"status": "completed", "input": {"path": "C:\\Users\\Arhys\\Desktop\\каллибровка\\verify_v4.py"}, "content": [{"type": "text", "text": "Read file C:\\Users\\Arhys\\Desktop\\каллибровка\\verify_v4.py, lines 1-297\n1: # -*- coding: utf-8 -*-\n2: \"\"\"verify_v4.py — детерминированная верификация реструктуризации v4.\n3: \n4: Проверяет в каждой книге new_versions_v4:\n5:   1. ВЕТКА 1: таблица 21 точка (строки 2..22), заголовок-подпись «ВЕТКА 1».\n6:   2. ВЕТКА 2 (НЕЗАВИСИМАЯ, «заданы температуры»): блок с 25.. — заголовок «ВЕТКА 2»,\n7:      21 строка, колонки T_НД | T_фикс | C_проверка | V1, мл | V2, мл | Vср, % | r, % | Статус;\n8:      T_фикс = (A - k*273)/(1+k), C_проверка; V1/V2 — ввод (пустые), Vср = (V1+V2)/2/Ввод!$G$1*100.\n9:   3. ПОЛИНОМ ВЕТКИ 1: LINEST ArrayFormula + таблица полинома + RSQ.\n10:   4. ВТОРАЯ МОДЕЛЬ (ВЕТКА 2): LINEST по фактическим точкам (Vср → T_НД) через\n11:      вспомогательные колонки «График» A/B + таблица + RSQ.\n12:   5. ГРАФИК: ДВЕ диаграммы; серии Ветки 1 (21 точка), серии Ветки 2 (Vср → T_НД).\n13:   6. Нет старых блоков: «Эксперимент при фиксированной», «МОДЕЛЬ ЭКСТРАПОЛЯЦИИ»,\n14:      «РЕГРЕССИЯ T = b1*V + b0», «V->T», «T->V».\n15:   7. Обратная задача: числовая проверка T_фикс при P=748, T_цель=150 -> ~149.5.\n16:   8. НЕЗАВИСИМОСТЬ ВЕТКИ 2: ячейка T_НД (A27) НЕ ссылается на лист «Ввод»/таблицу Ветки 1.\n17: \"\"\"\n18: import os\n19: import sys\n20: import math\n21: import openpyxl\n22: \n23: HERE = os.path.dirname(os.path.abspath(__file__))\n24: DIR = os.path.join(HERE, \"new_versions_v4\")\n25: \n26: PASS = 0\n27: FAIL = 0\n28: N_PTS = 21\n29: \n30: \n31: def check(cond, msg):\n32:     global PASS, FAIL\n33:     if cond:\n34:         PASS += 1\n35:         print(f\"  [PASS] {msg}\")\n36:     else:\n37:         FAIL += 1\n38:         print(f\"  [FAIL] {msg}\")\n39: \n40: \n41: def young_k_iso_d86(p_mm, t):\n42:     return 0.00012 * (760 - p_mm) * (273 + t)\n43: \n44: \n45: def young_k_gost(p_mm, t):\n46:     return 0.0009 * (101.3 - p_mm * 0.133322) * (273 + t)\n47: \n48: \n49: def t_fix(T_target, k_const, t):\n50:     return (T_target - k_const * 273) / (1 + k_const)\n51: \n52: \n53: def inverse_check():\n54:     print(\"\\n=== Обратная задача Янга (числовая) ===\")\n55:     # ISO/D86: P=748, T_цель=150\n56:     P = 748\n57:     T_target = 150.0\n58:     k = 0.00012 * (760 - P)\n59:     Tf = t_fix(T_target, k, T_target)\n60:     back = Tf + k * (273 + Tf)\n61:     print(f\"ISO/D86: P={P}, T_цель={T_target}: k={k:.6f}, T_фикс={Tf:.3f}, \"\n62:           f\"обратно T_фикс+k*273.15: {back:.3f} -> round0.5 = {round(back*2)/2:.1f}\")\n63:     check(abs(round(back * 2) / 2 - T_target) < 0.51, \"ISO/D86: обратная проверка сходится к 150\")\n64:     check(149.0 <= Tf <= 150.0, f\"ISO/D86: T_фикс в интервале [149..150]: {Tf:.2f}\")\n65: \n66:     # ГОСТ: P=748 -> 99.7 кПа\n67:     P_g = 748\n68:     kg = 0.0009 * (101.3 - P_g * 0.133322)\n69:     Tf_g = t_fix(T_target, kg, T_target)\n70:     back_g = Tf_g + kg * (273 + Tf_g)\n71:     print(f\"GOST: P={P_g}, T_цель={T_target}: k={kg:.6f}, T_фикс={Tf_g:.3f}, обратно={back_g:.3f}\")\n72:     check(abs(round(back_g * 2) / 2 - T_target) < 0.51, \"GOST: обратная проверка сходится к 150\")\n73: \n74: \n75: def verify_book(fname, path):\n76:     print(f\"\\n=== {fname} ===\")\n77:     wb = openpyxl.load_workbook(path)\n78:     check(\"Расчёт\" in wb.sheetnames, \"лист «Расчёт» существует\")\n79:     check(\"График\" in wb.sheetnames, \"лист «График» существует\")\n80:     ws2 = wb[\"Расчёт\"]\n81: \n82:     # --- ВЕТКА 1 ---\n83:     hdr = str(ws2.cell(1, 1).value or \"\")\n84:     tcorr_col = None\n85:     # определить колонку T_corr по заголовку\n86:     for c in range(1, 25):\n87:         v = str(ws2.cell(1, c).value or \"\")\n88:         if \"T_corr\" in v or \"AET\" in v:\n89:             tcorr_col = c\n90:             break\n91:     check(tcorr_col is not None, f\"колонка T_corr/AET найдена (col={tcorr_col})\")\n92:     if tcorr_col is None:\n93:         return\n94:     # строка 2..22 заполнены % отгона\n95:     vals = [ws2.cell(r, 1).value for r in range(2, 23)]\n96:     check(all(v is not None for v in vals), \"строки 2..22: % отгона заполнены (21 точка)\")\n97:     # подпись ветки 1\n98:     branch1_found = any(\"ВЕТКА 1\" in str(ws2.cell(1, c).value or \"\") for c in range(1, 30))\n99:     check(branch1_found, \"подпись «ВЕТКА 1» присутствует\")\n100: \n101:     # --- ВЕТКА 2 ---\n102:     b2_row = None\n103:     for r in range(23, 40):\n104:         v = str(ws2.cell(r, 1).value or \"\")\n105:         if \"ВЕТКА 2\" in v:\n106:             b2_row = r\n107:             break\n108:     check(b2_row is not None, f\"заголовок «ВЕТКА 2» найден (row={b2_row})\")\n109:     if b2_row:\n110:         hr = b2_row + 1\n111:         h2 = [str(ws2.cell(hr, c).value or \"\") for c in range(1, 9)]\n112:         check(any(\"T_НД\" in h for h in h2) or any(\"AET_цель\" in h for h in h2),\n113:               \"ВЕТКА 2: заголовок T_НД (или AET_цель для D1160)\")\n114:         check(any(\"T_фикс\" in h for h in h2), \"ВЕТКА 2: заголовок T_фикс\")\n115:         check(any(\"V1\" in h for h in h2), \"ВЕТКА 2: заголовок V1, мл (проба 1)\")\n116:         check(any(\"V2\" in h for h in h2), \"ВЕТКА 2: заголовок V2, мл (проба 2)\")\n117:         check(any(\"Vср\" in h for h in h2), \"ВЕТКА 2: заголовок Vср, %\")\n118:         check(any(\"r, %\" in h for h in h2), \"ВЕТКА 2: заголовок r, %\")\n119:         check(any(\"Статус\" in h for h in h2), \"ВЕТКА 2: заголовок Статус\")\n120:         # 21 строка данных — по наличию формул Vср (колонка F; ввод A/D/E пуст по замыслу)\n121:         d0 = hr + 1\n122:         n_rows = 0\n123:         for r in range(d0, d0 + 21):\n124:             if ws2.cell(r, 6).value is not None:\n125:                 n_rows += 1\n126:         check(n_rows == 21, f\"ВЕТКА 2: 21 строка данных с формулой Vср (найдено {n_rows})\")\n127:         # формула T_фикс\n128:         f_formula = str(ws2.cell(d0, 2).value or \"\")\n129:         check(\"(1+\" in f_formula or \"/\" in f_formula, f\"ВЕТКА 2: формула T_фикс есть: {f_formula[:60]}\")\n130:         # формула C_проверка — только если не AET (D1160: её нет, это ожидаемо)\n131:         c_formula = str(ws2.cell(d0, 3).value or \"\")\n132:         if tcorr_col == 5 and \"AET\" in str(ws2.cell(1, 5).value or \"\"):\n133:             check(c_formula == \"—\" or c_formula == \"\", \"D1160: C_проверка отсутствует (ожидаемо)\")\n134:         else:\n135:             check(\"-A\" in c_formula or \"A\" in c_formula, \"ВЕТКА 2: формула C_проверка есть\")\n136:         # V1/V2 — ВВОД (пустые зелёные)\n137:         v1 = ws2.cell(d0, 4).value\n138:         v2 = ws2.cell(d0, 5).value\n139:         check(v1 is None, f\"ВЕТКА 2: V1 (D{d0}) пустой (ввод) — найден: {v1!r}\")\n140:         check(v2 is None, f\"ВЕТКА 2: V2 (E{d0}) пустой (ввод) — найден: {v2!r}\")\n141:         # Vср формула = (V1+V2)/2 / Ввод!$G$1 * 100\n142:         vavg = str(ws2.cell(d0, 6).value or \"\")\n143:         check(\"Ввод!$G$1\" in vavg, f\"ВЕТКА 2: Vср ссылается на Ввод!$G$1: {vavg[:70]}\")\n144:         check(\"(D\" in vavg and \"E\" in vavg, f\"ВЕТКА 2: Vср = (V1+V2)/2/... : {vavg[:70]}\")\n145:         # T_НД — НЕЗАВИСИМАЯ ВЕТКА: ячейка ввода не ссылается на Ветку 1/Ввод\n146:         nd_a = ws2.cell(d0, 1).value\n147:         check(nd_a is None or (isinstance(nd_a, str) and \"=F\" not in nd_a and \"Ввод\" not in nd_a),\n148:               f\"ВЕТКА 2: T_НД (A{d0}) независима от Ветки 1/«Ввод»: {nd_a!r}\")\n149:         # r, % формула\n150:         r_formula = str(ws2.cell(d0, 7).value or \"\")\n151:         check(\"D\" in r_formula and \"E\" in r_formula, f\"ВЕТКА 2: r, % = f(V1,V2): {r_formula[:60]}\")\n152:         # Статус формула\n153:         st_formula = str(ws2.cell(d0, 8).value or \"\")\n154:         check(\"OK\" in st_formula, f\"ВЕТКА 2: Статус содержит «OK»: {st_formula[:60]}\")\n155: \n156:     # --- ПОЛИНОМ ВЕТКИ 1 ---\n157:     poly_row = None\n158:     for r in range(b2_row or 25, (b2_row or 25) + 30):\n159:         v = str(ws2.cell(r, 1).value or \"\")\n160:         if \"КУБИЧЕСКИМ\" in v and \"ВЕТКИ 1\" in v:\n161:             poly_row = r\n162:             break\n163:     check(poly_row is not None, f\"заголовок «АППРОКСИМАЦИЯ … ВЕТКИ 1 … КУБИЧЕСКИМ ПОЛИНОМОМ» найден (row={poly_row})\")\n164:     if poly_row:\n165:         a3 = ws2.cell(poly_row + 2, 1).value\n166:         check(isinstance(a3, openpyxl.worksheet.formula.ArrayFormula), \"полином Ветки 1: ArrayFormula LINEST в A\")\n167:         linest = a3.text if isinstance(a3, openpyxl.worksheet.formula.ArrayFormula) else \"\"\n168:         check(\"{1,2,3}\" in linest, f\"полином Ветки 1: LINEST 3-й степени (^{{1,2,3}}): {linest[:70]}\")\n169:         # R² — в строке r2_row (после таблицы полинома), колонка B\n170:         r2_row = poly_row + 3 + N_PTS + 1  # dr+1+n\n171:         r2_formula = str(ws2.cell(r2_row, 2).value or \"\")\n172:         check(r2_formula.startswith(\"=RSQ\"), f\"полином Ветки 1: R² = RSQ присутствует (B{r2_row}): {r2_formula[:50]}\")\n173:         # таблица полинома\n174:         dr = poly_row + 3\n175:         tpoly = str(ws2.cell(dr + 1, 3).value or \"\")\n176:         check(\"$A$\" in tpoly and \"^3\" in tpoly, f\"полином Ветки 1: T_полином=a3*V^3+... : {tpoly[:70]}\")\n177:         # остаток\n178:         resid = str(ws2.cell(dr + 1, 4).value or \"\")\n179:         check(\"C\" in resid and \"-C\" in resid, \"полином Ветки 1: остаток = T_corr − T_полином\")\n180: \n181:     # --- ВТОРАЯ МОДЕЛЬ (ВЕТКА 2) ---\n182:     poly2_row = None\n183:     for r in range((b2_row or 25) + 1, (b2_row or 25) + 60):\n184:         v = str(ws2.cell(r, 1).value or \"\")\n185:         if \"ВТОРАЯ МОДЕЛЬ\" in v or (\"ВЕТКА 2\" in v and \"КУБИЧЕСКИМ\" in v):\n186:             poly2_row = r\n187:             break\n188:     check(poly2_row is not None, f\"заголовок «ВТОРАЯ МОДЕЛЬ (ВЕТКА 2)» найден (row={poly2_row})\")\n189:     if poly2_row:\n190:         a3_2 = ws2.cell(poly2_row + 2, 1).value\n191:         check(isinstance(a3_2, openpyxl.worksheet.formula.ArrayFormula), \"полином Ветки 2: ArrayFormula LINEST в A\")\n192:         linest2 = a3_2.text if isinstance(a3_2, openpyxl.worksheet.formula.ArrayFormula) else \"\"\n193:         check(\"LINEST\" in linest2 and \"{1,2,3}\" in linest2,\n194:               f\"полином Ветки 2: LINEST ^{{1,2,3}} по вспомогательным: {linest2[:90]}\")\n195:         check(\"График\" in linest2, f\"полином Ветки 2: LINEST ссылается на лист «График»: {linest2[:90]}\")\n196:         # R²\n197:         r2_row2 = poly2_row + 3 + N_PTS + 1\n198:         r2_formula2 = str(ws2.cell(r2_row2, 2).value or \"\")\n199:         check(r2_formula2.startswith(\"=RSQ\"), f\"полином Ветки 2: R² = RSQ (B{r2_row2}): {r2_formula2[:50]}\")\n200:         # таблица второй модели\n201:         dr2 = poly2_row + 3\n202:         tpoly2 = str(ws2.cell(dr2 + 1, 3).value or \"\")\n203:         check(\"$A$\" in tpoly2 and \"^3\" in tpoly2, f\"полином Ветки 2: T_полином=a3*Vср^3+... : {tpoly2[:80]}\")\n204:         resid2 = str(ws2.cell(dr2 + 1, 4).value or \"\")\n205:         check(\"C\" in resid2 and \"-C\" in resid2, \"полином Ветки 2: остаток = T_НД − T_полином\")\n206: \n207:     # --- ГРАФИК ---\n208:     ws4 = wb[\"График\"]\n209:     # серии Ветки 1: строки 4..24 (21 точка)\n210:     x_vals = [ws4.cell(r, 1).value for r in range(4, 25)]\n211:     check(all(x is not None for x in x_vals), \"График: 21 точка % отгона (строки 4..24)\")\n212:     # есть 2 серии (колонки B и C)\n213:     b_series = [ws4.cell(r, 2).value for r in range(4, 25)]\n214:     c_series = [ws4.cell(r, 3).value for r in range(4, 25)]\n215:     check(all(x is not None for x in b_series), \"График: серия T_corr/AET по всем 21 точкам\")\n216:     check(all(x is not None for x in c_series), \"График: серия T_полином по всем 21 точкам\")\n217:     # диаграмма 1 и 2\n218:     check(len(ws4._charts) == 2, f\"График: ДВЕ диаграммы (найдено {len(ws4._charts)})\")\n219:     # консистентность: T_полином в графике ссылается на РАБОЧИЕ строки полинома Ветки 1,\n220:     # а не на заголовки (C54) и не обрезает последнюю точку\n221:     poly_row_found = None\n222:     for r in range((b2_row or 25), (b2_row or 25) + 30):\n223:         v = str(ws2.cell(r, 1).value or \"\")\n224:         if \"КУБИЧЕСКИМ\" in v and \"ВЕТКИ 1\" in v:\n225:             poly_row_found = r\n226:             break\n227:     if poly_row_found:\n228:         data_first = poly_row_found + 4          # первая строка таблицы полинома Ветки 1\n229:         data_last = data_first + N_PTS - 1       # последняя\n230:         c4 = str(ws4.cell(4, 3).value or \"\")\n231:         c24 = str(ws4.cell(24, 3).value or \"\")\n232:         check(f\"C{data_first}\" in c4, f\"График: C4 -> C{data_first} (T_полином, не заголовок): {c4}\")\n233:         check(f\"C{data_last}\" in c24, f\"График: C24 -> C{data_last} (последняя точка): {c24}\")\n234:         r2_ref = str(ws4.cell(26, 2).value or \"\")\n235:         r2_row = poly_row_found + 4 + N_PTS       # = start_row + 4 + n (dr+1+n)\n236:         check(f\"B{r2_row}\" in r2_ref,\n237:               f\"График: B26 -> B{r2_row} (R² Ветки 1): {r2_ref}\")\n238: \n239:     # серии Ветки 2: Vср (E) → T_НД (F) + T_полином Ветки 2 (G)\n240:     e_series = [ws4.cell(r, 5).value for r in range(4, 25)]\n241:     f_series = [ws4.cell(r, 6).value for r in range(4, 25)]\n242:     g_series = [ws4.cell(r, 7).value for r in range(4, 25)]\n243:     check(all(x is not None for x in e_series), \"График Ветка 2: серия Vср, % (E4..E24)\")\n244:     check(all(x is not None for x in f_series), \"График Ветка 2: серия T_НД (F4..F24)\")\n245:     check(all(x is not None for x in g_series), \"График Ветка 2: серия T_полином Ветки 2 (G4..G24)\")\n246:     # ссылки серий Ветки 2 на рабочие строки «Расчёт»\n247:     # (E = Vср из 'Расчёт'!F, F = T_НД из 'Расчёт'!A, G = T_полином Ветки 2 из 'Расчёт'!C)\n248:     if b2_row:\n249:         e4 = str(ws4.cell(4, 5).value or \"\")\n250:         e24 = str(ws4.cell(24, 5).value or \"\")\n251:         check(f\"F{hr + 1}\" in e4, f\"График Ветка 2: E4 -> 'Расчёт'!F{hr+1} (первая точка Vср): {e4}\")\n252:         check(f\"F{hr + 1 + 20}\" in e24, f\"График Ветка 2: E24 -> 'Расчёт'!F{hr+21} (последняя): {e24}\")\n253:         f4 = str(ws4.cell(4, 6).value or \"\")\n254:         check(f\"A{hr + 1}\" in f4, f\"График Ветка 2: F4 -> 'Расчёт'!A{hr+1} (первая T_НД): {f4}\")\n255:         # R² Ветки 2 на листе графика\n256:         r2b2 = str(ws4.cell(26, 6).value or \"\")\n257:         check(\"Расчёт\" in r2b2 and \"B\" in r2b2, f\"График Ветка 2: F26 -> R² Ветки 2: {r2b2}\")\n258: \n259:     # --- Вспомогательные колонки (пары Vср→T_НД без пустот) ---\n260:     h0 = 29\n261:     hl = h0 + N_PTS - 1\n262:     a_h = [ws4.cell(r, 1).value for r in range(h0, hl + 1)]\n263:     b_h = [ws4.cell(r, 2).value for r in range(h0, hl + 1)]\n264:     check(all(isinstance(v, str) and \"INDEX\" in v for v in a_h),\n265:           \"График: вспомогательная A29..A49 — INDEX/SMALL (Vср без пустот)\")\n266:     check(all(isinstance(v, str) and \"INDEX\" in v for v in b_h),\n267:           \"График: вспомогательная B29..B49 — INDEX/SMALL (T_НД без пустот)\")\n268:     check(all(\"ISNUMBER\" in v for v in a_h),\n269:           \"График: вспомогательная фильтрует ISNUMBER (Vср)\")\n270: \n271:     # --- СТАРЫЕ БЛОКИ УДАЛЕНЫ ---\n272:     all_text = []\n273:     for row in ws2.iter_rows():\n274:         for cell in row:\n275:             if cell.value is not None:\n276:                 all_text.append(str(cell.value))\n277:     joined = \"\\n\".join(all_text)\n278:     for banned in [\"Эксперимент при фиксированной\", \"МОДЕЛЬ ЭКСТРАПОЛЯЦИИ\",\n279:                    \"РЕГРЕССИЯ T = b1*V + b0\", \"V->T (фиксация\", \"T->V (объём\"]:\n280:         check(banned not in joined, f\"старый блок удалён: «{banned}»\")\n281: \n282: \n283: def main():\n284:     if not os.path.isdir(DIR):\n285:         print(f\"Нет каталога {DIR}\")\n286:         return 1\n287:     files = sorted(f for f in os.listdir(DIR) if f.lower().endswith(\".xlsx\"))\n288:     print(f\"Файлов: {len(files)}\")\n289:     inverse_check()\n290:     for f in files:\n291:         verify_book(f, os.path.join(DIR, f))\n292:     print(f\"\\n=== ИТОГ: PASS={PASS}, FAIL={FAIL} ===\")\n293:     return 0 if FAIL == 0 else 1\n294: \n295: \n296: if __name__ == \"__main__\":\n297:     sys.exit(main())"}], "metadata": {"truncated": false}}, "time": {"created": 1791912420225, "ran": 1791912420773, "completed": 1791912420791}}], "snapshot": {"start": "72ff983820157877c626134f7e479afabe0c662d", "end": "72ff983820157877c626134f7e479afabe0c662d", "files": []}, "finish": "tool-calls", "providerState": {"responseId": "resp_0f05ab37e548106a016ace69e6ce9487d2ad8f17f070898ce9", "serviceTier": "default"}, "cost": 0, "tokens": {"input": 1331, "output": 38, "reasoning": 154, "cache": {"read": 95744, "write": 0}}}}
