entuser') -Wait\n}\n\n# Завершить только процессы, запущенные из каталогов OpenCode\n$roots = @($desktopRoot, $desktopCli, $bunCli) |\n    Where-Object { Test-Path $_ } |\n    ForEach-Object { [IO.Path]::GetFullPath($_).TrimEnd('\\') + '\\' }\n\nGet-CimInstance Win32_Process |\n    Where-Object {\n        $_.ExecutablePath -and\n        ($path = [IO.Path]::GetFullPath($_.ExecutablePath)) -and\n        ($roots | Where-Object { $path.StartsWith($_, [StringComparison]::OrdinalIgnoreCase) })\n    } |\n    ForEach-Object {\n        Stop-Process -Id $_.ProcessId -Force -ErrorAction SilentlyContinue\n    }\n\n# Повторить деинсталляцию, если приложение осталось после закрытия процессов\nif (Test-Path $uninstaller) {\n    Start-Process -FilePath $uninstaller `\n        -ArgumentList @('/S', '/currentuser') -Wait\n}\n\n# Удалить только каталоги бинарников, если они остались\nforeach ($path in @($desktopRoot, $desktopCli, $bunCli)) {\n    if (Test-Path $path) {\n        Remove-Item -LiteralPath $path -Recurse -Force\n    }\n}\n\nWrite-Host 'Готово. Конфигурация, сессии и проекты не удалялись.'\n```\n\nЗапуск из PowerShell:\n\n```powershell\nSet-ExecutionPolicy -Scope Process Bypass\n.\\uninstall-opencode.ps1\n```", "state": {"itemId": "msg_098cb3b5f50176cb016acf9dd9add0819184323313759ad52f", "phase": "final_answer"}}], "snapshot": {"start": "1765fd4c0e0aa8b0755dc2a14507be3eecdeb181", "end": "1765fd4c0e0aa8b0755dc2a14507be3eecdeb181", "files": []}, "finish": "stop", "providerState": {"responseId": "resp_098cb3b5f50176cb016acf9dcee25481919c3999407c12d1a3", "serviceTier": "default"}, "cost": 0, "tokens": {"input": 1192, "output": 588, "reasoning": 1072, "cache": {"read": 74240, "write": 0}}}}
