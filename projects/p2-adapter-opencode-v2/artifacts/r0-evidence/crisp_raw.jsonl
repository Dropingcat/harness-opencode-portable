t", "text": "{\n  \"items\": [\n    {\n      \"path\": \"tools.browser.lighthouse\",\n      \"description\": \"Audit the current tab with Lighthouse for accessibility, SEO and best practices. Does not emulate a device or run a performance benchmark. Returns scores and server-local reports.\",\n      \"signature\": \"tools.browser.lighthouse({\\n  /**\\n   * Exact tab ID returned by browser.tabs.open/list. Focus does not select a tool target.\\n   * @pattern ^tab_[a-f0-9-]{36}$\\n   */\\n  tabID: string,\\n}): Promise<{\\n  tab: {\\n    /** @pattern ^tab_[a-f0-9-]{36}$ */\\n    id: string,\\n    /** @maxLength 16384 */\\n    url: string,\\n    /** @maxLength 2048 */\\n    title: string,\\n    loading: boolean,\\n    /** @maxLength 2048 */\\n    loadError?: string,\\n    canGoBack: boolean,\\n    canGoForward: boolean,\\n    /** @integer @minimum 0 */\\n    generation: number,\\n  },\\n  files: Array<{\\n      /** @pattern ^file_[a-f0-9-]{36}$ */\\n      id: string,\\n      /** @maxLength 2048 */\\n      name: string,\\n      /** @maxLength 2048 */\\n      mime: string,\\n      /** @integer @minimum 0 */\\n      bytes: number,\\n      path: string,\\n    }>,\\n  scores: Array<{\\n      /** @maxLength 2048 */\\n      id: string,\\n      /** @maxLength 2048 */\\n      title: string,\\n      score: number | null,\\n    }>,\\n  failures: Array<{\\n      /** @maxLength 2048 */\\n      id: string,\\n      /** @maxLength 2048 */\\n      title: string,\\n      /** @maxLength 100000 */\\n      description: string,\\n    }>,\\n}>\"\n    },\n    {\n      \"path\": \"tools.browser.trace.start\",\n      \"description\": \"Start a bounded Chromium performance trace for this tab's renderer process. Only one recording can run in the desktop app. It is not a network or system-wide capture.\",\n      \"signature\": \"tools.browser.trace.start({\\n  /**\\n   * Exact tab ID returned by browser.tabs.open/list. Focus does not select a tool target.\\n   * @pattern ^tab_[a-f0-9-]{36}$\\n   */\\n  tabID: string,\\n  /** @integer @minimum 1000 @maximum 30000 */\\n  durationMs?: number,\\n}): Promise<{\\n  tab: {\\n    /** @pattern ^tab_[a-f0-9-]{36}$ */\\n    id: string,\\n    /** @maxLength 16384 */\\n    url: string,\\n    /** @maxLength 2048 */\\n    title: string,\\n    loading: boolean,\\n    /** @maxLength 2048 */\\n    loadError?: string,\\n    canGoBack: boolean,\\n    canGoForward: boolean,\\n    /** @integer @minimum 0 */\\n    generation: number,\\n  },\\n  recording: boolean,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.models\",\n      \"description\": \"Search the models available to use. Use this to turn a model name the user mentions into an exact reference before running a subagent on it. Check your own provider first.\",\n      \"signature\": \"tools.opencode.models({\\n  /** Text to search for in model names and IDs. */\\n  query?: string,\\n  /** Provider ID or name to filter by. Try your own provider first. */\\n  provider?: string,\\n  /** Include older versions of each model family. By default only the newest version is listed. */\\n  all?: boolean,\\n  /** Maximum number of models to return. Defaults to 20. @integer @minimum 1 @maximum 100 */\\n  limit?: number,\\n  /** Number of models to skip, for paging through results. @integer @minimum 0 */\\n  offset?: number,\\n}): Promise<{\\n  /** Matching models grouped by provider. Your own provider comes first. */\\n  providers: Array<{\\n      id: string,\\n      name: string,\\n      /** Newest first. */\\n      models: Array<{\\n          /** providerID/modelID */\\n          id: string,\\n          name: string,\\n          /** Release date as a Unix timestamp in milliseconds, or 0 when unknown. */\\n          released: number,\\n          variants: Array<string>,\\n          /** Pricing in USD per million tokens. */\\n          cost: Array<{\\n              tier?: {\\n                type: \\\"context\\\",\\n                /** @integer */\\n                size: number,\\n              },\\n              input: number,\\n              output: number,\\n              cache: {\\n                read: number,\\n                write: number,\\n              },\\n            }>,\\n          status: \\\"alpha\\\" | \\\"beta\\\" | \\\"deprecated\\\" | \\\"active\\\",\\n        }>,\\n    }>,\\n  /** Number of matching models across all pages. @integer */\\n  total: number,\\n  /** Offset of the next page, or null on the last page. */\\n  next: number | null,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.read_mcp_resource\",\n      \"description\": \"Read one MCP resource by server and URI. Not for local files. Always return the full contents rather than slicing or filtering them; oversized output is truncated automatically and the full content is saved to a file you can read. Images and PDFs are shown to you directly.\",\n      \"signature\": \"tools.opencode.read_mcp_resource({\\n  /** The server field of the discovered resource. */\\n  server: string,\\n  /** Exact resource URI from discovery, an expanded uriTemplate, or the user. */\\n  uri: string,\\n}): Promise<{\\n  server: string,\\n  uri: string,\\n  contents: Array<{\\n        type: \\\"text\\\",\\n        uri: string,\\n        text: string,\\n        mimeType?: string,\\n      } | {\\n        type: \\\"blob\\\",\\n        uri: string,\\n        blob: string,\\n        mimeType?: string,\\n      }>,\\n}>\"\n    },\n    {\n      \"path\": \"tools.opencode.session_move\",\n      \"description\": \"Move a session to another directory, or omit sessionID to move the current session. The current session moves at the next safe boundary; do not run destination-dependent tools in the same execute call.\",\n      \"signature\": \"tools.opencode.session_move({\\n  /** Omit to move the current session. @pattern ^ses */\\n  sessionID?: string,\\n  /** Destination directory, relative to the target session's directory or absolute. Supports ~. @minLength 1 */\\n  directory: string,\\n}): Promise<{\\n  /** @pattern ^ses */\\n  sessionID: string,\\n  directory: string,\\n}>\"\n    }\n  ],\n  \"remaining\": 0,\n  \"next\": null\n}"}], "metadata": {"toolCalls": [{"tool": "search", "status": "completed", "input": {"query": "harness status run", "limit": 10}}], "truncated": false}}, "time": {"created": 1791912699823, "ran": 1791912700312, "completed": 1791912700371}}], "snapshot": {"start": "51b0aa4f7569bfc382f152edbf4eaa537bdbb511", "end": "51b0aa4f7569bfc382f152edbf4eaa537bdbb511", "files": []}, "finish": "tool-calls", "providerState": {"responseId": "resp_0f05ab37e548106a016ace6afce56087d2a20c8c7c660d5fce", "serviceTier": "default"}, "cost": 0, "tokens": {"input": 3962, "output": 36, "reasoning": 271, "cache": {"read": 132608, "write": 0}}}}
