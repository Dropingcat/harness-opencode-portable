                                  \r\n-a---- ॢ�� 4.txt                                              \r\n-a---- �央���_�ࠪ樮���.md                                   \r\n\r\n\r\n"}], "metadata": {"status": "completed", "truncated": false, "exit": 0}}, "time": {"created": 1791912169120, "ran": 1791912169131, "completed": 1791912171696}}, {"type": "tool", "id": "call_kLtsTdjvvaLERDJS0bGsMOlD", "name": "read", "executed": false, "providerState": {"itemId": "fc_0f05ab37e548106a016ace68f04a6487d2a2b9b3af67bc4b5b"}, "state": {"status": "completed", "input": {"path": "C:\\Users\\Arhys\\Desktop\\каллибровка\\reviewer_fraction_v311.json"}, "content": [{"type": "text", "text": "Read file C:\\Users\\Arhys\\Desktop\\каллибровка\\reviewer_fraction_v311.json, lines 1-77\n1: {\n2:   \"module\": \"fraction_xlsx_v3.11\",\n3:   \"verdict\": \"REQUEST_CHANGES\",\n4:   \"comments\": [\n5:     {\n6:       \"severity\": \"critical\",\n7:       \"file\": \"new_versions_v3_11/фракционка ГОСТ_2177 (v3.11).xlsx и фракционка ГОСТ_2177 автомат. прил.А (v3.11).xlsx\",\n8:       \"location\": \"Расчёт!G2:G22\",\n9:       \"issue\": \"«Восст. отгон» = 'Ввод'!D{4+i}+'Ввод'!E{4+i}, т.е. T2 (температура!) + E-колонка «Потери» (пустая в строках 4-24). По ГОСТ 2177-99 5.5.5 восстановленный общий отгон = объём конденсата + остаток (в листе «Ввод» это B{r} (V, мл) + F25 (остаток, %), т.е. B{r}/$G$1*100 + F25). На синтетике: G2 = D4+E4 = 131+0 = 131 вместо 0+1.0 = 1.0. Каскадно ломает H (Потери = 100−G → −31), I (Выпаривание), M (Отгонкор), T (Режим по 5.5.6).\",\n10:       \"suggestion\": \"G{r} = 'Ввод'!B{r}/$G$1*100 + 'Ввод'!$F$25 (объём конденсата в % + остаток). Проверить, что H=100−G даёт наблюдаемые потери E25 (0.5), а M = отгон + (потери − Lкор) без остатка (Rc = R + (L−Lc), аналог 11.4.1).\",\n11:       \"falsification\": \"Замечание опровергнуто, если при синтетических данных (V=0..100, остаток=1.0, потери=0.5) G2='Ввод'!B4/100*100+'Ввод'!F25 даёт 1.0 (а не 131), H2=0.5, M2=100−Lкор+... без включения остатка.\"\n12:     },\n13:     {\n14:       \"severity\": \"major\",\n15:       \"file\": \"new_versions_v3_11/ГОСТ ISO 3405 расчет (v3.11).xlsx, АСТМ Д 86 ручной метод (v3.11).xlsx, АСТМ Д 86 автомат. метод (v3.11).xlsx\",\n16:       \"location\": \"Расчёт!M4..M20 (крутизна S, точки 10-90%)\",\n17:       \"issue\": \"Крутизна для точек 10-90% считается центральной разностью ±5%: M4 (10%) = ABS(F5-F3)/(A5-A3) = (T15−T5)/10; M20 (90%) = (T95−T85)/10. По ГОСТ ISO 3405 табл.5 / ASTM D86 A4.3 наклон для точек, указанных в таблице, считается по фиксированным интервалам: 10% → 0→20, 20% → 10→30, 30% → 20→40, …, 80% → 70→90, 90% → 80→90; для непоказанных 10-85% — Sc = 0.05·(T_{V+10}−T_{V−10}) = (T_{V+10}−T_{V−10})/20. Текущая формула даёт вдвое больший наклон (деление на 10 вместо 20) и не те интервалы, что искажает все r/R (0.864·S+1.214 и т.д.).\",\n18:       \"suggestion\": \"Ввести таблицу интервалов наклона (аналог slope_rules ГОСТ 2177): 10:(0,20), 20:(10,30), 30:(20,40), 40:(30,50), 50:(40,60), 60:(50,70), 70:(60,80), 80:(70,90), 90:(80,90), 95:(90,95), IBP:(0,5), 5:(0,10); для 15/25/…/85 — (V−10,V+10)/20.\",\n19:       \"falsification\": \"Замечание опровергнуто, если M4 (10%) станет = ABS(F4−F2)/(A4−A2) (интервал 0→20) и M20 (90%) = ABS(F20−F18)/(A20−A18) (интервал 80→90), а M5 (15%) = ABS(F6−F4)/20.\"\n20:     },\n21:     {\n22:       \"severity\": \"major\",\n23:       \"file\": \"new_versions_v3_11/АСТМ Д 86 автомат. метод (v3.11).xlsx\",\n24:       \"location\": \"Расчёт!I2/J2 (IBP) и I22/J22 (FBP)\",\n25:       \"issue\": \"Для IBP/FBP в автоматической книге стоят константы РУЧНОГО метода: I2=IF(D1=1,3.3,0.35*M2+1.0), J2=IF(D1=1,5.6,0.93*M2+2.8); I22=IF(D1=1,3.9,0.36*M22+0.7), J22=IF(D1=1,7.2,0.42*M22+3.1). По ASTM D86-20a для автоматического метода: Табл.7 (гр.1-3) IBP r=2.7/R=4.7, FBP r=3.3/R=7.1; Табл.10 (гр.4) IBP r=0.018·T/R=0.055·T, FBP r=2.2/R=7.1. Значения ручного метода в auto-книге не соответствуют заявленному стандарту.\",\n26:       \"suggestion\": \"Для method='auto' заменить IBP/FBP на Табл.7 (2.7/4.7; 3.3/7.1) и Табл.10 для группы 4 (0.018·T/0.055·T; 2.2/7.1), как в ГОСТ ISO 3405-2022 табл.8/9.\",\n27:       \"falsification\": \"Замечание опровергнуто, если при D1=1 (гр.1) I2=2.7 и J2=4.7, I22=3.3 и J22=7.1, а для гр.4 используются формулы 0.018*F2/0.055*F2.\"\n28:     },\n29:     {\n30:       \"severity\": \"major\",\n31:       \"file\": \"new_versions_v3_11/фракционка ГОСТ_2177 (v3.11).xlsx и фракционка ГОСТ_2177 автомат. прил.А (v3.11).xlsx\",\n32:       \"location\": \"Расчёт! (блок T->V, rev_t+3 / rev_t+4, ~строки 31-32)\",\n33:       \"issue\": \"В блоке «T->V (объём при температуре)» r/R рассчитываются по ISO-формулам: IF(Ввод!$E$1=1,0.864*M13+1.214,0.41*M13+1.0) и 1.736*M13+1.994 / 1.33*M13+1.8, где M — колонка «Отгонкор» (а не крутизна!). По ГОСТ 2177-99 5.6.1/5.6.2 сходимость/воспроизводимость определяются ТОЛЬКО по номограмме (рис.6) через крутизну C (5.6.3) — колонка S. Использование ISO-коэффициентов и колонки «Отгонкор» вместо номограммы — несоответствие ГОСТ 2177.\",\n34:       \"suggestion\": \"В блоках T->V и V->T ГОСТ 2177 r/R брать из листа «Номограмма» по крутизне S (как сделано в блоке эксперимента: INDEX(Номограмма!B$2:B$52,MATCH(MIN(S12,5),...))).\",\n35:       \"falsification\": \"Замечание опровергнуто, если в T->V блоке r = INDEX(Номограмма!B$2:B$52,MATCH(MIN(S12,5),Номограмма!A$2:A$52,-1)) и не содержит констант 0.864/1.736/0.41/1.33.\"\n36:     },\n37:     {\n38:       \"severity\": \"major\",\n39:       \"file\": \"new_versions_v3_11/фракционка ГОСТ_2177 автомат. прил.А (v3.11).xlsx\",\n40:       \"location\": \"вся книга (gen_gost2177 automatic=True)\",\n41:       \"issue\": \"Книга заявлена как «ГОСТ 2177-99 — автоматический аппарат (приложение А)», но реализует ровно ту же структуру и формулы метода А (ручной аппарат): тот же лист «Расчёт», те же номограмма/табл.4, нет таблицы А.1 точности приложения А и своей поправки давления, о чём прямо сказано в docstring генератора («На текущем этапе генерируется та же структура с пометкой режима»). Приложение А ГОСТ 2177-99 имеет собственную таблицу А.1 (пределы повторяемости/воспроизводимости для автоматических аппаратов) — книга не соответствует заявленному стандарту.\",\n42:       \"suggestion\": \"Либо реализовать таблицу А.1 и специфику приложения А (свои r/R, поправки), либо переименовать книгу в «метод А (автоматический аппарат по 5.6)» и явно указать, что приложение А не реализовано.\",\n43:       \"falsification\": \"Замечание опровергнуто, если в книге приложения А появится таблица А.1 (отдельные r/R для автоматических аппаратов) или иные формулы точности, отличные от номограммы метода А.\"\n44:     },\n45:     {\n46:       \"severity\": \"minor\",\n47:       \"file\": \"new_versions_v3_11/ГОСТ ISO 3405 расчет (v3.11).xlsx, АСТМ Д 86 ручной метод (v3.11).xlsx\",\n48:       \"location\": \"Расчёт!A2:A22 (нормировка r/R по % отгона для группы 1)\",\n49:       \"issue\": \"Для группы 1 прецизионность в ГОСТ ISO 3405 (13.1) и ASTM D86 (A4.4) нормируется по % ВЫПАРИВАНИЯ (Pe = Pr + L), а для групп 2-4 — по % отгона. Книга для всех групп использует один и тот же ряд % отгона (A) и наклон по нему. Для группы 1 точки должны быть сдвинуты на потери (Pe = отгон + потери) перед расчётом наклона и точек r/R.\",\n50:       \"suggestion\": \"Для группы 1 добавить расчёт Pe = Pr + L (выпаривание) и определять r/R и наклон по Pe, как предписывает стандарт.\",\n51:       \"falsification\": \"Замечание опровергнуто, если для D1=1 (группа 1) при L>0 наклон и точки r/R рассчитываются по Pe=Pr+L, а не по колонке A.\"\n52:     },\n53:     {\n54:       \"severity\": \"minor\",\n55:       \"file\": \"new_versions_v3_11/фракционка ГОСТ_2177 (v3.11).xlsx и фракционка ГОСТ_2177 автомат. прил.А (v3.11).xlsx\",\n56:       \"location\": \"Расчёт!S3 (крутизна для точки 5%)\",\n57:       \"issue\": \"Крутизна для 5% = интервал (0,10) шириной 10% (slope_rules[5]=(0,10)). По 5.6.3 (и комментарию в коде) для точек вне диапазона 10-90% допустим интервал до 5%. Точка 5% вне 10-90%, интервал (0,10) шириной 10% нарушает это ограничение (в отличие от 0%: (0,5) и 95/100%: (90,95)/(95,100)).\",\n58:       \"suggestion\": \"slope_rules[5] = (0,5) либо (5,10) — интервал ≤5%, согласованный с ограничением 5.6.3.\",\n59:       \"falsification\": \"Замечание опровергнуто, если для точки 5% в книге используется интервал шириной ≤5% (например, (0,5) или (5,10)).\"\n60:     },\n61:     {\n62:       \"severity\": \"minor\",\n63:       \"file\": \"new_versions_v3_11/АСТМ Д 86 автомат. метод (v3.11).xlsx\",\n64:       \"location\": \"Расчёт!I5/I7/I9/I11/I13/I15/I17/I19 (точки 15/25/35/45/55/65/75/85%)\",\n65:       \"issue\": \"Для точек, отсутствующих в Табл.7 ASTM D86-20a (15, 25, 35, 45, 55, 65, 75, 85%), книга использует fallback r=1.0+k, R=2.0+k без ссылки на нормативный источник — Табл.7 определяет точность только для 5/10/20/…/95%. Это произвольное расширение, не подкреплённое стандартом.\",\n66:       \"suggestion\": \"Пометить такие точки как «не нормировано Табл.7» (пусто/«—») либо явно указать источник интерполяции, чтобы лаборант не принимал fallback за норматив.\",\n67:       \"falsification\": \"Замечание опровергнуто, если для точек 15/25/…/85% в auto-книге стоит пустое значение или явная пометка «не нормировано» вместо r=1.0+k/R=2.0+k.\"\n68:     }\n69:   ],\n70:   \"out_of_scope_gaps\": [\n71:     \"D1160: не реализована поправка AET на K-фактор Уотсона (A7.7: t = 1.4·(K−12)·lg(Pa/Po)) и не проверяется ограничение K=12±0.2 (A7.3.2) — книга считает AET без учёта K-фактора образца.\",\n72:     \"D1160: в отличие от ISO/D86/ГОСТ книг нет листа «График» и блока «МОДЕЛЬ ЭКСТРАПОЛЯЦИИ» — функциональная несимметричность набора книг.\",\n73:     \"ГОСТ 2177: на листе «Ввод» отсутствует DataValidation для ячейки «Группа (1 или 2-4)» (E1), тогда как в ISO/D86 книгах группа (D1) валидируется диапазоном 1-4.\",\n74:     \"ISO 3405: сгенерирована только ручная книга (табл.6/7); автоматический метод (табл.8/9 ГОСТ ISO 3405-2022) в наборе v3.11 отсутствует, хотя D86 auto присутствует.\",\n75:     \"Крутизна в блоках «Эксперимент при фиксированной T» и T->V использует точку 50% (M12) как репрезентативную для всей кривой — для точек вне 50% это приближение, не оговорённое в книге.\"\n76:   ]\n77: }"}], "metadata": {"truncated": false}}, "time": {"created": 1791912169134, "ran": 1791912169185, "completed": 1791912169231}}, {"type": "tool", "id": "call_kessijk2Jfv2esyltU7D0hK2", "name": "read", "executed": false, "providerState": {"itemId": "fc_0f05ab37e548106a016ace68f04a6c87d2a90af8cf15502b36"}, "state": {"status": "completed", "input": {"path": "C:\\Users\\Arhys\\Desktop\\каллибровка\\restructure_v4.py"}, "content": [{"type": "text", "text": "Read file C:\\Users\\Arhys\\Desktop\\каллибровка\\restructure_v4.py, lines 1-661\n1: # -*- coding: utf-8 -*-\n2: \"\"\"restructure_v4.py — реструктуризация листа «Расчёт» в ДВЕ ВЕТКИ + полиномиальный фитинг.\n3: \n4: Проблема (по аудиту gen_fraction_xlsx_v3_11.py):\n5:   [КУЧА]  Лист «Расчёт» содержит 5+ блоков без разделения: таблица 21×15,\n6:           V->T, T->V, «Эксперимент при фиксированной T», «МОДЕЛЬ ЭКСТРАПОЛЯЦИИ»,\n7:           «РЕГРЕССИЯ T=b1*V+b0» (ЛИНЕЙНАЯ). Лаборант не понимает, что и куда вводить.\n8:   [БАГ]   График: Reference(max_row=2+n_pts) при данных до строки 3+n_pts —\n9:           последняя точка (100%/КК) НЕ попадает в диаграмму; min_row=3 включает заголовок.\n10:   [БАГ]   Аппроксимация — линейная (SLOPE/INTERCEPT/RSQ). Кривая дистилляции S-образная,\n11:           линейной НИКОГДА не будет → нужен полином.\n12: \n13: Решение (v4):\n14:   ВЕТКА 1 (таблица сверху): «заданы ОБЪЁМЫ (выпаривание)» → % отгона → T1/T2 →\n15:           поправка Янга → T_corr (приведена к 760). Это базовая таблица 21×15 — остаётся.\n16:           Ввод объёмов/температур — на листе «Ввод» (зелёные), G1 = объём образца, мл.\n17: \n18:   ВЕТКА 2 (новый блок ниже) — НЕЗАВИСИМАЯ ветка «заданы ТЕМПЕРАТУРЫ (из НД, при 760)»:\n19:           Лаборант вводит на листе «Расчёт» температуры из НД (нормируемые при 760),\n20:           например T1=150, T2=160, T3=250.\n21:           Скрипт/книга решает ОБРАТНУЮ задачу Янга: T_фикс = (T_цель − k·273)/(1+k),\n22:           k = 0.00012·(760−P) для ISO/D86, k = 0.0009·(101.3−P_кПа) для ГОСТ 2177.\n23:           При P=748, T=150 → T_фикс=149.5 (фиксировать на градус ниже).\n24:           Лаборант проводит дистилляцию, фиксируя T_фикс, и вбивает ОБЪЁМЫ в ДВУХ\n25:           ПАРАЛЛЕЛЯХ: колонки «V1, мл (проба 1)» и «V2, мл (проба 2)» — ВВОД (зелёные).\n26:           Vср, % = (V1+V2)/2 / Ввод!$G$1 * 100 — расчёт.\n27:           Строится ВТОРОЙ график (Vср, % → T_НД, °C) и ВТОРАЯ модель — кубический полином\n28:           (LINEST ^{1,2,3}) по фактически введённым точкам Ветки 2 (собраны подряд без\n29:           пустот во вспомогательную колонку).\n30:           Ветка 1 и Ветка 2 НЕЗАВИСИМЫ.\n31: \n32:   ПОЛИНОМ (Ветка 1): аппроксимация кривой полиномом 3-й степени через LINEST.\n33:   ПОЛИНОМ (Ветка 2): вторая модель T_НД = a3·Vср³ + a2·Vср² + a1·Vср + a0 по фактическим\n34:           точкам (Vср → T_НД) — вспомогательные колонки без пустот (SMALL/IFERROR),\n35:           LINEST по ним.\n36:   ГРАФИК: лист «График» — ДВЕ диаграммы:\n37:           №1 «Ветка 1»: % отгона → T_corr + полином Ветки 1;\n38:           №2 «Ветка 2»: Vср, % → T_НД + полином Ветки 2.\n39: \n40: Верификация ресерчера (формулы коррекции):\n41:   КЛЮЧЕВЫЕ_ГОСТ_2177-99.md (стр.27): C=0,0009·(101,3−P_кПа)·(273+t₀) ≡ 0,00012·(760−P_мм)·(273+t)\n42:   КЛЮЧЕВЫЕ_ASTM_D86.md (стр.22): C = 0.00012·(760−P)·(273+t)  — формула (4)\n43:   СВОДКА_ДЛЯ_СВЕРКИ_И_ПРАВКИ.md (стр.14): Excel `0.00012*(760-P)*(273+t)` — КОРРЕКТНА.\n44:   → Ресерчер понял нормативки верно.\n45: \n46: Запуск:\n47:     python restructure_v4.py [--in DIR] [--out DIR]\n48:     DIR по умолчанию: new_versions_v3_11 -> new_versions_v4\n49: \"\"\"\n50: from __future__ import annotations\n51: \n52: import os\n53: import sys\n54: import logging\n55: from dataclasses import dataclass\n56: from typing import List, Optional, Tuple\n57: \n58: import openpyxl\n59: from openpyxl.styles import Font, PatternFill, Alignment, Border, Side\n60: from openpyxl.worksheet.formula import ArrayFormula\n61: \n62: logging.basicConfig(level=logging.INFO, format=\"%(asctime)s - %(levelname)s - %(message)s\")\n63: logger = logging.getLogger(__name__)\n64: \n65: # ----------------------------------------------------------------------------\n66: # Стили\n67: # ----------------------------------------------------------------------------\n68: _thin = Side(style=\"thin\", color=\"B7B7B7\")\n69: BORDER = Border(left=_thin, right=_thin, top=_thin, bottom=_thin)\n70: F_HDR = Font(bold=True, color=\"FFFFFF\")\n71: F_BOLD = Font(bold=True)\n72: F_REF = Font(italic=True, color=\"7F6000\", size=9)\n73: FILL_HDR = PatternFill(\"solid\", fgColor=\"4F81BD\")\n74: FILL_INPUT = PatternFill(\"solid\", fgColor=\"E2EFDA\")\n75: FILL_CALC = PatternFill(\"solid\", fgColor=\"DDEBF7\")\n76: FILL_BRANCH = PatternFill(\"solid\", fgColor=\"FFF2CC\")   # заголовок ветки\n77: FILL_WARN = PatternFill(\"solid\", fgColor=\"FFEB9C\")\n78: FILL_POLY = PatternFill(\"solid\", fgColor=\"E4DFEC\")     # блок полинома\n79: \n80: \n81: def _set(ws, row, col, value, fill=None, bold=False, fmt=None, font=None):\n82:     cell = ws.cell(row, col, value)\n83:     if fill:\n84:         cell.fill = fill\n85:     if bold:\n86:         cell.font = F_BOLD\n87:     if font:\n88:         cell.font = font\n89:     if fmt:\n90:         cell.number_format = fmt\n91:     cell.border = BORDER\n92:     return cell\n93: \n94: \n95: # ----------------------------------------------------------------------------\n96: # Конфигурация стандартов (колонки листа «Расчёт» в v3.11)\n97: # ----------------------------------------------------------------------------\n98: @dataclass(frozen=True)\n99: class StdCfg:\n100:     tag: str\n101:     tcol: int                 # колонка T_corr (ISO/D86/ГОСТ = F(6); D1160 = E(5) AET)\n102:     rcol: int                 # колонка r  (ISO/D86=I(9); ГОСТ=O(15); D1160=F(6))\n103:     Rcol: int                 # колонка R  (ISO/D86=J(10); ГОСТ=P(16); D1160=G(7))\n104:     scount: int               # число колонок таблицы\n105:     young_k: Optional[str]    # k = поправочный коэффициент Янга (None для D1160 — AET)\n106:     aet: bool = False         # D1160: T_corr заменён на AET, обратная поправка не нужна\n107: \n108:     @property\n109:     def tcol_letter(self) -> str:\n110:         return openpyxl.utils.get_column_letter(self.tcol)\n111: \n112: \n113: STD_CFG = {\n114:     \"iso\": StdCfg(\"ISO 3405\", 6, 9, 10, 15, \"0.00012*(760-Ввод!$B$1)\"),\n115:     \"d86\": StdCfg(\"D86\", 6, 9, 10, 15, \"0.00012*(760-Ввод!$B$1)\"),\n116:     \"gost\": StdCfg(\"GOST 2177\", 6, 15, 16, 22, \"0.0009*(101.3-Ввод!$B$1*0.133322)\"),\n117:     \"d1160\": StdCfg(\"D1160\", 5, 6, 7, 11, None, aet=True),\n118: }\n119: \n120: \n121: def detect_std(fname: str, ws2) -> Optional[str]:\n122:     \"\"\"Определяет стандарт по имени файла и заголовкам листа «Расчёт».\"\"\"\n123:     low = fname.lower()\n124:     h1 = str(ws2.cell(1, 5).value or \"\")\n125:     if \"AET\" in h1:                    # D1160: колонка E = AET\n126:         return \"d1160\"\n127:     if \"2177\" in low and \"iso\" not in low and \"3405\" not in low:\n128:         return \"gost\"\n129:     if \"iso\" in low or \"3405\" in low:\n130:         return \"iso\"\n131:     if \"86\" in low:\n132:         return \"d86\"\n133:     return None\n134: \n135: \n136: # ----------------------------------------------------------------------------\n137: # ВЕТКА 1 (базовая таблица 21×15) — константы строк\n138: # ----------------------------------------------------------------------------\n139: N_PTS = 21  # 0..100%, строки 2..22\n140: TBL_FIRST = 2        # первая строка таблицы Ветки 1\n141: TBL_LAST = 1 + N_PTS  # = 22, последняя строка таблицы Ветки 1\n142: \n143: # ВЕТКА 2 (независимая, «заданы температуры»): строки\n144: BRANCH2_START = 25\n145: BRANCH2_HEADER = BRANCH2_START + 1        # 26 — шапка колонок\n146: BRANCH2_FIRST = BRANCH2_HEADER + 1        # 27 — первая строка данных\n147: BRANCH2_LAST = BRANCH2_FIRST + N_PTS - 1  # 47 — последняя (21-я) строка данных\n148: BRANCH2_NOTE = BRANCH2_LAST + 1           # 48 — примечание-инструкция\n149: BRANCH2_END = BRANCH2_NOTE + 1            # 49 — строка после блока\n150: \n151: # Колонки Ветки 2 (1-индексные):\n152: B2_ND = 1      # A — T_НД (заданная температура из НД, при 760), ВВОД\n153: B2_FIX = 2     # B — T_фикс (что фиксировать при текущем давлении), расчёт\n154: B2_CHK = 3     # C — C_проверка (обратная сверка), расчёт\n155: B2_V1 = 4      # D — V1, мл (проба 1), ВВОД (зелёная, пустая)\n156: B2_V2 = 5      # E — V2, мл (проба 2), ВВОД (зелёная, пустая)\n157: B2_VAVG = 6    # F — Vср, % = (V1+V2)/2 / Ввод!$G$1 * 100, расчёт\n158: B2_R = 7       # G — r, %\n159: B2_ST = 8      # H — Статус\n160: B2_TIP = 9     # I — подсказка/комментарий в шапке\n161: \n162: # ПОЛИНОМ ВЕТКИ 1 (после блока Ветки 2):\n163: POLY_START = BRANCH2_END + 1              # 50 — заголовок «АППРОКСИМАЦИЯ…»\n164: POLY_COEF_ROW = POLY_START + 2            # 52 — ArrayFormula LINEST (якорь A)\n165: POLY_DATA_ROW = POLY_START + 4            # 54 — первая строка таблицы V|T_corr|T_полином|Остаток\n166: POLY_LAST = POLY_DATA_ROW + N_PTS - 1     # 74 — последняя строка таблицы\n167: POLY_R2_ROW = POLY_DATA_ROW + N_PTS       # 75 — R² (RSQ)\n168: POLY_NOTE = POLY_R2_ROW + 1               # 76 — примечание\n169: POLY_END = POLY_NOTE + 1                  # 77 — строка после блока (первая свободная)\n170: \n171: # ПОЛИНОМ ВЕТКИ 2 (после блока полинома Ветки 1):\n172: POLY2_START = POLY_END                    # 77 — заголовок «ВТОРАЯ МОДЕЛЬ…»\n173: POLY2_COEF_ROW = POLY2_START + 2          # 79 — ArrayFormula LINEST (якорь A)\n174: POLY2_DATA_ROW = POLY2_START + 4          # 81 — первая строка таблицы Vср|T_НД|T_полином|Остаток\n175: POLY2_LAST = POLY2_DATA_ROW + N_PTS - 1   # 101 — последняя строка таблицы\n176: POLY2_R2_ROW = POLY2_DATA_ROW + N_PTS     # 102 — R² (RSQ)\n177: POLY2_NOTE = POLY2_R2_ROW + 1             # 103 — примечание\n178: POLY2_END = POLY2_NOTE + 1                # 104 — строка после блока\n179: \n180: # Вспомогательная колонка сбора фактических пар Vср→T_НД (без пустот) — на «Графике»:\n181: G2_HELPER_FIRST = 29   # первая строка вспомогательной области на листе «График»\n182: G2_HELPER_LAST = G2_HELPER_FIRST + N_PTS - 1  # 49\n183: \n184: \n185: def _interp_v_formula(t_cell: str, tcol_letter: str, n: int = N_PTS) -> str:\n186:     \"\"\"Линейная интерполяция V% по T_цель на кривой T_corr (F$2:F$22).\"\"\"\n187:     last = 1 + n\n188:     return (\n189:         f'=IF(AND(ISNUMBER({t_cell}),{t_cell}>=MIN({tcol_letter}${TBL_FIRST}:{tcol_letter}${last}),'\n190:         f'{t_cell}<=MAX({tcol_letter}${TBL_FIRST}:{tcol_letter}${last})),'\n191:         f'INDEX(A${TBL_FIRST}:A${last},MATCH({t_cell},{tcol_letter}${TBL_FIRST}:{tcol_letter}${last},1))'\n192:         f'+({t_cell}-INDEX({tcol_letter}${TBL_FIRST}:{tcol_letter}${last},'\n193:         f'MATCH({t_cell},{tcol_letter}${TBL_FIRST}:{tcol_letter}${last},1)))'\n194:         f'*(INDEX(A${TBL_FIRST}:A${last},MATCH({t_cell},{tcol_letter}${TBL_FIRST}:{tcol_letter}${last},1)+1)'\n195:         f'-INDEX(A${TBL_FIRST}:A${last},MATCH({t_cell},{tcol_letter}${TBL_FIRST}:{tcol_letter}${last},1)))'\n196:         f'/(INDEX({tcol_letter}${TBL_FIRST}:{tcol_letter}${last},'\n197:         f'MATCH({t_cell},{tcol_letter}${TBL_FIRST}:{tcol_letter}${last},1)+1)'\n198:         f'-INDEX({tcol_letter}${TBL_FIRST}:{tcol_letter}${last},'\n199:         f'MATCH({t_cell},{tcol_letter}${TBL_FIRST}:{tcol_letter}${last},1))),\"Экстраполяция\")'\n200:     )\n201: \n202: \n203: def _rR_at_v_formula(v_cell: str, col: int, n: int = N_PTS) -> str:\n204:     \"\"\"r/R из строки таблицы, ближайшей к найденному V%.\"\"\"\n205:     L = openpyxl.utils.get_column_letter(col)\n206:     last = 1 + n\n207:     return f'=IF(ISNUMBER({v_cell}),INDEX({L}${TBL_FIRST}:{L}${last},MATCH({v_cell},A${TBL_FIRST}:A${last},1)),\"\")'\n208: \n209: \n210: # ----------------------------------------------------------------------------\n211: # ВЕТКА 2: заданы температуры -> T_фикс + объёмы двух параллелей -> Vср%\n212: # ----------------------------------------------------------------------------\n213: def build_branch2(ws2, cfg: StdCfg, start_row: int = BRANCH2_START) -> int:\n214:     \"\"\"Строит НЕЗАВИСИМЫЙ блок ВЕТКИ 2 после строки start_row. Возвращает строку после блока.\n215: \n216:     Логика (заданы ТЕМПЕРАТУРЫ, независимо от Ветки 1):\n217:       1. Лаборант вводит на листе «Расчёт» температуры из НД (при 760): T_НД (колонка A).\n218:       2. Обратная задача Янга: T_фикс = (T_цель − k·273)/(1+k) — колонка B.\n219:       3. Дистилляция проводится при фиксации T_фикс; лаборант вбивает ОБЪЁМЫ двух\n220:          параллелей: V1, мл (D) и V2, мл (E) — ВВОД (зелёные, пустые).\n221:       4. Vср, % = (V1+V2)/2 / Ввод!$G$1 * 100 — колонка F (расчёт).\n222:       5. r, % (колонка G) и Статус (H) — по паре V1/V2.\n223:     \"\"\"\n224:     tL = cfg.tcol_letter\n225:     n = N_PTS\n226:     last = 1 + n\n227: \n228:     title = (\n229:         \"ВЕТКА 2 — ЗАДАНЫ ТЕМПЕРАТУРЫ (независимая ветка, ввод на этом листе): \"\n230:         \"температуры из НД (нормируемые при 760 мм рт.ст.) → T_фикс (что ФИКСИРОВАТЬ \"\n231:         \"на термометре при текущем давлении) → лаборант вводит ОБЪЁМЫ двух параллелей \"\n232:         \"(V1, V2) → Vср, % = (V1+V2)/2 / Ввод!$G$1 * 100 → второй график и вторая модель\"\n233:         + (\"\" if cfg.young_k else \" — D1160: пересчёт по AET, фиксация T не используется\")\n234:     )\n235:     _set(ws2, start_row, 1, title, fill=FILL_BRANCH, bold=True, font=Font(bold=True, size=11))\n236: \n237:     if cfg.young_k:\n238:         hdr = [\"T_НД (при 760), °C\", \"T_фикс (ФИКСИРОВАТЬ), °C\",\n239:                \"C_проверка, °C\", \"V1, мл (проба 1)\", \"V2, мл (проба 2)\",\n240:                \"Vср, %\", \"r, %\", \"Статус\"]\n241:     else:\n242:         hdr = [\"AET_цель, °C\", \"T_фикс (н/п для AET)\", \"—\",\n243:                \"V1, мл (проба 1)\", \"V2, мл (проба 2)\", \"Vср, %\", \"r, %\", \"Статус\"]\n244: \n245:     hr = start_row + 1\n246:     for c, h in enumerate(hdr, 1):\n247:         _set(ws2, hr, c, h, fill=FILL_HDR, bold=True)\n248: \n249:     # Подсказка-комментарий в шапке ветки (колонка I, видна при наведении/в строке формул)\n250:     if cfg.young_k:\n251:         tip = (\"ВЕТКА 2 — НЕЗАВИСИМАЯ ветка «заданы температуры». \"\n252:                \"1) В колонку A (T_НД) введите числами температуры из НД (нормируемые при 760), \"\n253:                \"например 150, 160, 250. \"\n254:                \"2) В колонке B — T_фикс = (T_цель − k·273)/(1+k): какую температуру ФИКСИРОВАТЬ \"\n255:                \"на термометре при текущем давлении; C_проверка≈0 — пересчёт верен. \"\n256:                \"3) Проведите дистилляцию, фиксируя T_фикс, и вбейте объёмы ДВУХ ПАРАЛЛЕЛЕЙ: \"\n257:                \"колонки D (V1, мл, проба 1) и E (V2, мл, проба 2) — зелёные. \"\n258:                \"4) Vср, % = (V1+V2)/2 / Ввод!$G$1 * 100 — расчёт (F). \"\n259:                \"По точкам (Vср → T_НД) строится ВТОРОЙ график и ВТОРАЯ модель (кубический \"\n260:                \"полином) — см. лист «График». Ветка 1 и Ветка 2 НЕЗАВИСИМЫ.\")\n261:     else:\n262:         tip = (\"ВЕТКА 2 (D1160): введите нужный AET (атмосферный эквивалент) в колонке A. \"\n263:                \"Фиксация наблюдаемой T здесь не используется — кривая строится по AET. \"\n264:                \"Объёмы двух параллелей — колонки D/E, Vср, % — колонка F.\")\n265:     _set(ws2, hr, B2_TIP, \"ПОДСКАЗКА\", fill=FILL_HDR, bold=True)\n266:     _set(ws2, hr + 1, B2_TIP, tip, fill=FILL_WARN, font=F_REF)\n267: \n268:     for i in range(n):\n269:         r = hr + 1 + i\n270:         # A: T_НД — ВВОД (числом). Пустая по умолчанию: ветка НЕЗАВИСИМА от Ветки 1.\n271:         _set(ws2, r, B2_ND, None, fill=FILL_INPUT, fmt=\"0.0\")\n272:         if i < 3:\n273:             from openpyxl.comments import Comment\n274:             ws2.cell(r, B2_ND).comment = Comment(\n275:                 \"Введите температуру из НД (нормируемую при 760 мм рт.ст.) ЧИСЛОМ.\\n\"\n276:                 \"Пример: 150 → T_фикс покажет, какую температуру ФИКСИРОВАТЬ на \"\n277:                 \"термометре при текущем давлении, чтобы получить 150 при 760.\",\n278:                 \"автоматизация\", height=90, width=320)\n279:         if cfg.young_k:\n280:             # B: T_фикс — обратная задача Янга: T_цель = T_фикс + k*(273+T_фикс)\n281:             _set(ws2, r, B2_FIX,\n282:                  f'=IF(ISNUMBER(A{r}),(A{r}-{cfg.young_k}*273)/(1+{cfg.young_k}),\"\")',\n283:                  fill=FILL_CALC, fmt=\"0.0\")\n284:             # C: C_проверка: вернёмся к T_цель — верификация прямо в книге\n285:             _set(ws2, r, B2_CHK,\n286:                  f'=IF(ISNUMBER(A{r}),B{r}+{cfg.young_k}*(273+B{r})-A{r},\"\")',\n287:                  fill=FILL_CALC, fmt=\"0.00\")\n288:         else:\n289:             _set(ws2, r, B2_FIX, \"н/п (AET)\", fill=FILL_CALC)\n290:             _set(ws2, r, B2_CHK, \"—\", fill=FILL_CALC)\n291:         # D/E: V1, V2 — ВВОД (зелёные, пустые) — объёмы двух параллелей при фиксированной T\n292:         _set(ws2, r, B2_V1, None, fill=FILL_INPUT, fmt=\"0.0\")\n293:         _set(ws2, r, B2_V2, None, fill=FILL_INPUT, fmt=\"0.0\")\n294:         # F: Vср, % = (V1+V2)/2 / Ввод!$G$1 * 100 — расчёт\n295:         _set(ws2, r, B2_VAVG,\n296:              f'=IF(AND(ISNUMBER(D{r}),ISNUMBER(E{r})),(D{r}+E{r})/2/Ввод!$G$1*100,\"\")',\n297:              fill=FILL_CALC, fmt=\"0.0\")\n298:         # G: r, % — относительный разброс параллелей\n299:         _set(ws2, r, B2_R,\n300:              f'=IF(AND(ISNUMBER(D{r}),ISNUMBER(E{r}),F{r}<>0),'\n301:              f'ABS(D{r}-E{r})/(D{r}+E{r})*100,\"\")',\n302:              fill=FILL_CALC, fmt=\"0.00\")\n303:         # H: Статус — наличие T_НД и пары объёмов\n304:         _set(ws2, r, B2_ST,\n305:              f'=IF(ISNUMBER(A{r}),IF(AND(ISNUMBER(D{r}),ISNUMBER(E{r})),\"OK\",'\n306:              f'\"введи V1 и V2\"),\"—\")',\n307:              fill=FILL_CALC)\n308: \n309:     note = BRANCH2_NOTE\n310:     if cfg.young_k:\n311:         _set(ws2, note, 1,\n312:              \"КАК ПОЛЬЗОВАТЬСЯ ВЕТКОЙ 2 (НЕЗАВИСИМАЯ, «заданы температуры»): \"\n313:              \"в колонке A (T_НД, зелёная) введите температуры из НД числами, например 150, 160, 250. \"\n314:              \"Обратная задача Янга: T_фикс = (T_цель − k·273)/(1+k), \"\n315:              f\"k = {cfg.young_k}. \"\n316:              \"Пример: P=748, T_цель=150 → k=0.00144 → T_фикс=149.4≈149.5 (фиксировать на градус ниже). \"\n317:              \"C_проверка≈0 — пересчёт верен. \"\n318:              \"Проведите дистилляцию, фиксируя T_фикс, и вбейте объёмы ДВУХ ПАРАЛЛЕЛЕЙ: \"\n319:              \"V1 (D) и V2 (E). Vср, % = (V1+V2)/2 / Ввод!$G$1 * 100. \"\n320:              \"По точкам (Vср → T_НД) строятся ВТОРОЙ график и ВТОРАЯ модель. \"\n321:              \"Ветка 1 (заданы объёмы, лист «Ввод») и Ветка 2 НЕЗАВИСИМЫ.\",\n322:              fill=FILL_WARN, font=F_REF)\n323:     else:\n324:         _set(ws2, note, 1,\n325:              \"D1160: кривая строится по AET (Максвелл-Боннелл); заданная температура — AET, \"\n326:              \"фиксация наблюдаемой T требует обратного AET — не применяется. \"\n327:              \"Объёмы двух параллелей — V1/V2 (D/E), Vср, % — (F).\",\n328:              fill=FILL_WARN, font=F_REF)\n329:     return BRANCH2_END\n330: \n331: \n332: # ----------------------------------------------------------------------------\n333: # ПОЛИНОМИАЛЬНАЯ АППРОКСИМАЦИЯ (Ветка 1): T_corr = a3·V³ + a2·V² + a1·V + a0\n334: # ----------------------------------------------------------------------------\n335: def build_poly_fit(ws2, cfg: StdCfg, start_row: int) -> int:\n336:     \"\"\"Блок полинома Ветки 1: T_corr = a3·V³ + a2·V² + a1·V + a0 (КУБИЧЕСКИЙ).\n337: \n338:     LINEST(F$2:F$22, A$2:A$22^{1,2,3}) — динамический массив (Excel 365/2021)\n339:     или массивная формула (CSE). Выдаёт [a3, a2, a1, a0] в 4 ячейках.\n340: \n341:     Почему не линейный и не 2-й степени: кривая дистилляции S-образная;\n342:     линейная аппроксимация даёт систематические остатки, парабола (2-я степень)\n343:     — max|остаток| ~17°C на синтетике. Кубический полином — стандартный компромисс\n344:     (max ~9°C, R² ~0.993, устойчив к шуму).\n345:     \"\"\"\n346:     tL = cfg.tcol_letter\n347:     n = N_PTS\n348:     last = 1 + n\n349:     hr = start_row\n350:     _set(ws2, hr, 1, \"АППРОКСИМАЦИЯ КРИВОЙ ВЕТКИ 1 КУБИЧЕСКИМ ПОЛИНОМОМ \"\n351:          \"(T_corr = a3·V³+a2·V²+a1·V+a0; кривая НЕ линейна):\",\n352:          fill=FILL_POLY, bold=True, font=Font(bold=True, size=11))\n353:     # Строка коэффициентов\n354:     _set(ws2, hr + 1, 1, \"a3 (x³)\", fill=FILL_HDR, bold=True)\n355:     _set(ws2, hr + 1, 2, \"a2 (x²)\", fill=FILL_HDR, bold=True)\n356:     _set(ws2, hr + 1, 3, \"a1 (x)\", fill=FILL_HDR, bold=True)\n357:     _set(ws2, hr + 1, 4, \"a0\", fill=FILL_HDR, bold=True)\n358:     # Сначала форматируем ячейки, потом кладём ArrayFormula в A (якорь)\n359:     _set(ws2, hr + 2, 1, None, fill=FILL_CALC, fmt=\"0.000\")\n360:     _set(ws2, hr + 2, 2, None, fill=FILL_CALC, fmt=\"0.000\")\n361:     _set(ws2, hr + 2, 3, None, fill=FILL_CALC, fmt=\"0.000\")\n362:     _set(ws2, hr + 2, 4, None, fill=FILL_CALC, fmt=\"0.00\")\n363:     ref = f\"A{hr+2}:D{hr+2}\"\n364:     ws2[\"A%d\" % (hr + 2)] = ArrayFormula(\n365:         ref, f\"=LINEST({tL}${TBL_FIRST}:{tL}${last},A${TBL_FIRST}:A${last}^{{1,2,3}})\")\n366: \n367:     # Таблица: V% | T_corr (эксп.) | T_полином | Остаток\n368:     dr = hr + 3\n369:     _set(ws2, dr, 1, \"V, %\", fill=FILL_HDR, bold=True)\n370:     _set(ws2, dr, 2, \"T_corr (эксп.), °C\", fill=FILL_HDR, bold=True)\n371:     _set(ws2, dr, 3, \"T_полином, °C\", fill=FILL_HDR, bold=True)\n372:     _set(ws2, dr, 4, \"Остаток (эксп−полином)\", fill=FILL_HDR, bold=True)\n373:     for i in range(n):\n374:         r = dr + 1 + i\n375:         _set(ws2, r, 1, f\"=A{2+i}\", fill=FILL_CALC)\n376:         _set(ws2, r, 2, f\"={tL}{2+i}\", fill=FILL_CALC, fmt=\"0.0\")\n377:         _set(ws2, r, 3,\n378:              f'=IF(ISNUMBER({tL}{2+i}),$A${hr+2}*A{r}^3+$B${hr+2}*A{r}^2+$C${hr+2}*A{r}+$D${hr+2},\"\")',\n379:              fill=FILL_CALC, fmt=\"0.0\")\n380:         _set(ws2, r, 4,\n381:              f'=IF(AND(ISNUMBER({tL}{2+i}),ISNUMBER(C{r})),{tL}{2+i}-C{r},\"\")',\n382:              fill=FILL_CALC, fmt=\"0.0\")\n383:     # R²: RSQ(эксп, полином) по всей таблице — заполняется после строк таблицы\n384:     r2_row = dr + 1 + n\n385:     _set(ws2, r2_row, 1, \"R² (эксп vs полином):\", fill=FILL_POLY, bold=True)\n386:     _set(ws2, r2_row, 2,\n387:          f\"=RSQ(B{dr+1}:B{dr+n},C{dr+1}:C{dr+n})\",\n388:          fill=FILL_CALC, fmt=\"0.0000\")\n389:     note = r2_row + 1\n390:     _set(ws2, note, 1,\n391:          \"Кубический полином подобран по ВСЕМ точкам кривой Ветки 1 (LINEST). \"\n392:          \"Остатки показывают качество фитинга. Для S-образной кривой линейная и \"\n393:          \"параболическая аппроксимации неприменимы (систематические остатки) — используется куб.\",\n394:          fill=FILL_WARN, font=F_REF)\n395:     return note + 1\n396: \n397: \n398: # ----------------------------------------------------------------------------\n399: # ВТОРАЯ МОДЕЛЬ (ВЕТКА 2): T_НД = a3·Vср³ + a2·Vср² + a1·Vср + a0\n400: # по фактически введённым точкам (Vср → T_НД), собранным без пустот\n401: # ----------------------------------------------------------------------------\n402: def build_poly_fit_branch2(ws2, cfg: StdCfg, start_row: int = POLY2_START) -> int:\n403:     \"\"\"Блок ВТОРОЙ МОДЕЛИ: кубический полином по фактическим точкам Ветки 2.\n404: \n405:     Пары (Vср, % → T_НД) собираются подряд БЕЗ ПУСТОТ во вспомогательные колонки\n406:     (A/B вспомогательной области) формулами:\n407:         A: =IFERROR(INDEX('Расчёт'!$F$27:$F$47,SMALL(IF(ISNUMBER('Расчёт'!$F$27:$F$47),ROW(...)-ROW(...)+1),k)),\"\")\n408:         B: =IFERROR(INDEX('Расчёт'!$A$27:$A$47,SMALL(IF(ISNUMBER('Расчёт'!$F$27:$F$47),ROW(...)-ROW(...)+1),k)),\"\")\n409:     Затем LINEST по вспомогательным колонкам без пустот:\n410:         =LINEST(B9:B29, A9:A29^{1,2,3})   (якорь A, ArrayFormula)\n411:     Таблица Vср | T_НД | T_полином | Остаток + R²=RSQ.\n412:     \"\"\"\n413:     n = N_PTS\n414:     f0 = BRANCH2_FIRST     # 27\n415:     fl = BRANCH2_LAST      # 47\n416:     h0 = G2_HELPER_FIRST   # 29\n417:     hl = G2_HELPER_LAST    # 49\n418: \n419:     hr = start_row\n420:     _set(ws2, hr, 1,\n421:          \"ВТОРАЯ МОДЕЛЬ (ВЕТКА 2): T_НД = a3·Vср³+a2·Vср²+a1·Vср+a0 \"\n422:          \"по ФАКТИЧЕСКИ ВВЕДЁННЫМ точкам (Vср → T_НД), собранным без пустот:\",\n423:          fill=FILL_POLY, bold=True, font=Font(bold=True, size=11))\n424:     # Строка коэффициентов\n425:     _set(ws2, hr + 1, 1, \"a3 (x³)\", fill=FILL_HDR, bold=True)\n426:     _set(ws2, hr + 1, 2, \"a2 (x²)\", fill=FILL_HDR, bold=True)\n427:     _set(ws2, hr + 1, 3, \"a1 (x)\", fill=FILL_HDR, bold=True)\n428:     _set(ws2, hr + 1, 4, \"a0\", fill=FILL_HDR, bold=True)\n429:     _set(ws2, hr + 2, 1, None, fill=FILL_CALC, fmt=\"0.000\")\n430:     _set(ws2, hr + 2, 2, None, fill=FILL_CALC, fmt=\"0.000\")\n431:     _set(ws2, hr + 2, 3, None, fill=FILL_CALC, fmt=\"0.000\")\n432:     _set(ws2, hr + 2, 4, None, fill=FILL_CALC, fmt=\"0.00\")\n433:     # Вспомогательные колонки находятся на листе «График» (A/B, строки h0..hl)\n434:     ref = f\"A{hr+2}:D{hr+2}\"\n435:     ws2[f\"A{hr+2}\"] = ArrayFormula(\n436:         ref, f\"=LINEST('График'!B{h0}:B{hl},'График'!A{h0}:A{hl}^{{1,2,3}})\")\n437: \n438:     # Таблица: Vср, % | T_НД | T_полином | Остаток\n439:     dr = hr + 3\n440:     _set(ws2, dr, 1, \"Vср, %\", fill=FILL_HDR, bold=True)\n441:     _set(ws2, dr, 2, \"T_НД, °C (из НД, при 760)\", fill=FILL_HDR, bold=True)\n442:     _set(ws2, dr, 3, \"T_полином, °C\", fill=FILL_HDR, bold=True)\n443:     _set(ws2, dr, 4, \"Остаток (T_НД−T_полином)\", fill=FILL_HDR, bold=True)\n444:     for i in range(n):\n445:         r = dr + 1 + i\n446:         # ссылки на вспомогательные колонки листа «График» (пары без пустот)\n447:         _set(ws2, r, 1, f\"='График'!A{h0+i}\", fill=FILL_CALC, fmt=\"0.0\")\n448:         _set(ws2, r, 2, f\"='График'!B{h0+i}\", fill=FILL_CALC, fmt=\"0.0\")\n449:         _set(ws2, r, 3,\n450:              f'=IF(ISNUMBER(\\'График\\'!B{h0+i}),$A${hr+2}*\\'График\\'!A{h0+i}^3'\n451:              f'+$B${hr+2}*\\'График\\'!A{h0+i}^2+$C${hr+2}*\\'График\\'!A{h0+i}+$D${hr+2},\"\")',\n452:              fill=FILL_CALC, fmt=\"0.0\")\n453:         _set(ws2, r, 4,\n454:              f'=IF(AND(ISNUMBER(\\'График\\'!B{h0+i}),ISNUMBER(C{r})),\\'График\\'!B{h0+i}-C{r},\"\")',\n455:              fill=FILL_CALC, fmt=\"0.0\")\n456:     r2_row = dr + 1 + n\n457:     _set(ws2, r2_row, 1, \"R² (T_НД vs полином Ветки 2):\", fill=FILL_POLY, bold=True)\n458:     _set(ws2, r2_row, 2,\n459:          f\"=RSQ(B{dr+1}:B{dr+n},C{dr+1}:C{dr+n})\",\n460:          fill=FILL_CALC, fmt=\"0.0000\")\n461:     note = r2_row + 1\n462:     _set(ws2, note, 1,\n463:          \"ВТОРАЯ модель построена по фактически введённым точкам Ветки 2 \"\n464:          \"(только строки, где есть и Vср, и T_НД; пары собраны во вспомогательные \"\n465:          \"колонки A/B на листе «График» без пустот). Пока не введены данные — \"\n466:          \"коэффициенты пусты (LINEST по пустому диапазону). \"\n467:          \"Ветка 2 независима от Ветки 1.\",\n468:          fill=FILL_WARN, font=F_REF)\n469:     return note + 1\n470: \n471: \n472: # ----------------------------------------------------------------------------\n473: # ГРАФИК: ДВЕ диаграммы (Ветка 1: %→T_corr+полином; Ветка 2: Vср→T_НД+полином)\n474: # ----------------------------------------------------------------------------\n475: # Строки на листе «Расчёт» (вычисляются константами выше):\n476: #   ВЕТКА 2:     25..49 (данные 27..47)\n477: #   ПОЛИНОМ 1:   50 .. 76 (таблица 54..74, R² в 75)\n478: #   ПОЛИНОМ 2:   77 .. 103 (таблица 81..101, R² в 102)\n479: # (константы POLY_* / POLY2_* определены в секции выше)\n480: \n481: \n482: def rebuild_chart(wb, cfg: StdCfg, tag: str):\n483:     \"\"\"Перестраивает лист «График»: ДВЕ диаграммы + вспомогательные колонки.\n484: \n485:     Диаграмма 1 (Ветка 1): X=% отгона, Y=T_corr (21 точка) + T_полином Ветки 1.\n486:     Диаграмма 2 (Ветка 2): X=Vср, %, Y=T_НД (фактические точки) + T_полином Ветки 2.\n487:     Вспомогательные колонки A/B (строки 29..49) — пары Vср→T_НД БЕЗ ПУСТОТ\n488:     (для LINEST второй модели и второй диаграммы).\n489:     \"\"\"\n490:     from openpyxl.chart import LineChart, Reference\n491: \n492:     if \"График\" in wb.sheetnames:\n493:         del wb[\"График\"]\n494:     ws4 = wb.create_sheet(\"График\")\n495:     tL = cfg.tcol_letter\n496:     n = N_PTS\n497:     last = 1 + n\n498:     p0 = POLY_DATA_ROW        # первая строка таблицы полинома Ветки 1 (54)\n499:     q0 = POLY2_DATA_ROW       # первая строка таблицы полинома Ветки 2 (81)\n500:     b2f = BRANCH2_FIRST       # первая строка данных Ветки 2 (27)\n501:     b2l = BRANCH2_LAST        # последняя строка данных Ветки 2 (47)\n502:     h0 = G2_HELPER_FIRST      # первая строка вспомогательной области (29)\n503:     hl = G2_HELPER_LAST       # последняя (49)\n504: \n505:     # --- Вспомогательные колонки: пары Vср→T_НД без пустот ---\n506:     _set(ws4, h0 - 2, 1, \"ВСПОМОГАТЕЛЬНАЯ ОБЛАСТЬ (Ветка 2): пары Vср → T_НД, \"\n507:          \"собранные БЕЗ ПУСТОТ (для LINEST второй модели и второй диаграммы)\",\n508:          fill=FILL_WARN, bold=True)\n509:     _set(ws4, h0 - 1, 1, \"Vср, % (без пустот)\", fill=FILL_HDR, bold=True)\n510:     _set(ws4, h0 - 1, 2, \"T_НД, °C (без пустот)\", fill=FILL_HDR, bold=True)\n511:     for i in range(n):\n512:         r = h0 + i\n513:         k = i + 1\n514:         ws4.cell(r, 1).value = (\n515:             f'=IFERROR(INDEX(\\'Расчёт\\'!$F${b2f}:$F${b2l},'\n516:             f'SMALL(IF(ISNUMBER(\\'Расчёт\\'!$F${b2f}:$F${b2l}),'\n517:             f'ROW(\\'Расчёт\\'!$F${b2f}:$F${b2l})-ROW(\\'Расчёт\\'!$F${b2f})+1),{k})),\"\")'\n518:         )\n519:         ws4.cell(r, 2).value = (\n520:             f'=IFERROR(INDEX(\\'Расчёт\\'!$A${b2f}:$A${b2l},'\n521:             f'SMALL(IF(ISNUMBER(\\'Расчёт\\'!$F${b2f}:$F${b2l}),'\n522:             f'ROW(\\'Расчёт\\'!$F${b2f}:$F${b2l})-ROW(\\'Расчёт\\'!$F${b2f})+1),{k})),\"\")'\n523:         )\n524:         _set(ws4, r, 1, ws4.cell(r, 1).value, fill=FILL_CALC, fmt=\"0.0\")\n525:         _set(ws4, r, 2, ws4.cell(r, 2).value, fill=FILL_CALC, fmt=\"0.0\")\n526: \n527:     # --- Таблицы данных для диаграмм ---\n528:     ws4[\"A1\"] = (f\"Графики дистилляции ({tag}). \"\n529:                  f\"Диаграмма 1 — Ветка 1 (% отгона → T_corr + полином); \"\n530:                  f\"Диаграмма 2 — Ветка 2 (Vср, % → T_НД + полином).\")\n531:     # Диаграмма 1: колонки A,B,C (строки 3..24)\n532:     ws4[\"A3\"] = \"% отгона\"\n533:     ws4[\"B3\"] = \"T_corr (эксперимент)\" if not cfg.aet else \"AET (эксперимент)\"\n534:     ws4[\"C3\"] = \"T_полином (аппроксимация)\"\n535:     for i in range(n):\n536:         r = 4 + i          # строка в «График»\n537:         r_in = 2 + i       # строка в «Расчёт»\n538:         ws4.cell(r, 1, f\"='Расчёт'!A{r_in}\")\n539:         ws4.cell(r, 2, f\"='Расчёт'!{tL}{r_in}\")\n540:         ws4.cell(r, 3, f\"='Расчёт'!C{p0+i}\")\n541:     _set(ws4, 26, 1, \"R² (полином Ветки 1, из листа «Расчёт»):\", fill=FILL_WARN, bold=True)\n542:     ws4.cell(26, 2, f\"='Расчёт'!B{POLY_R2_ROW}\")\n543: \n544:     # Диаграмма 2: колонки E,F,G (строки 3..24) — только заполненные строки Ветки 2\n545:     ws4[\"E3\"] = \"Vср, % (Ветка 2)\"\n546:     ws4[\"F3\"] = \"T_НД, °C (из НД, при 760)\"\n547:     ws4[\"G3\"] = \"T_полином Ветки 2 (аппроксимация)\"\n548:     for i in range(n):\n549:         r = 4 + i\n550:         ws4.cell(r, 5, f\"='Расчёт'!F{b2f+i}\")\n551:         ws4.cell(r, 6, f\"='Расчёт'!A{b2f+i}\")\n552:         ws4.cell(r, 7, f\"='Расчёт'!C{q0+i}\")\n553:     _set(ws4, 26, 5, \"R² (полином Ветки 2, из листа «Расчёт»):\", fill=FILL_WARN, bold=True)\n554:     ws4.cell(26, 6, f\"='Расчёт'!B{POLY2_R2_ROW}\")\n555: \n556:     # --- Диаграмма 1 (Ветка 1) ---\n557:     chart1 = LineChart()\n558:     chart1.title = f\"Ветка 1 — дистилляция {tag}: эксперимент vs полином, R² = 'Расчёт'!B{POLY_R2_ROW}\"\n559:     chart1.style = 13\n560:     chart1.y_axis.title = \"Температура, °C\"\n561:     chart1.x_axis.title = \"Объём отгона, %\"\n562:     chart1.y_axis.scaling.min = 0\n563:     ref_t = Reference(ws4, min_col=2, min_row=3, max_row=3 + n)\n564:     ref_pct = Reference(ws4, min_col=1, min_row=4, max_row=3 + n)\n565:     chart1.add_data(ref_t, titles_from_data=True)\n566:     chart1.set_categories(ref_pct)\n567:     ref_p = Reference(ws4, min_col=3, min_row=3, max_row=3 + n)\n568:     chart1.add_data(ref_p, titles_from_data=True)\n569:     ws4.add_chart(chart1, \"E28\")\n570: \n571:     # --- Диаграмма 2 (Ветка 2): X=Vср, Y=T_НД + полином Ветки 2 ---\n572:     chart2 = LineChart()\n573:     chart2.title = f\"Ветка 2 — T_НД (из НД, при 760) vs Vср, R² = 'Расчёт'!B{POLY2_R2_ROW}\"\n574:     chart2.style = 12\n575:     chart2.y_axis.title = \"Температура, °C (T_НД, при 760)\"\n576:     chart2.x_axis.title = \"Vср, % (по двум параллелям)\"\n577:     # y не ставим min=0 — у T_НД шкала естественная\n578:     ref_nd = Reference(ws4, min_col=6, min_row=3, max_row=3 + n)\n579:     ref_vavg = Reference(ws4, min_col=5, min_row=4, max_row=3 + n)\n580:     chart2.add_data(ref_nd, titles_from_data=True)\n581:     chart2.set_categories(ref_vavg)\n582:     ref_p2 = Reference(ws4, min_col=7, min_row=3, max_row=3 + n)\n583:     chart2.add_data(ref_p2, titles_from_data=True)\n584:     ws4.add_chart(chart2, \"E52\")\n585: \n586: \n587: # ----------------------------------------------------------------------------\n588: # Основная обработка книги\n589: # ----------------------------------------------------------------------------\n590: def process_book(src_path: str, out_path: str) -> Tuple[bool, str]:\n591:     \"\"\"Перестраивает одну книгу. Возвращает (ok, сообщение).\"\"\"\n592:     wb = openpyxl.load_workbook(src_path)\n593:     if \"Расчёт\" not in wb.sheetnames:\n594:         return False, \"нет листа «Расчёт»\"\n595:     ws2 = wb[\"Расчёт\"]\n596:     fname = os.path.basename(src_path)\n597:     std = detect_std(fname, ws2)\n598:     if std is None:\n599:         return False, f\"не удалось определить стандарт: {fname}\"\n600:     cfg = STD_CFG[std]\n601: \n602:     # 1) Удалить весь «мусор» после базовой таблицы (строки 23..конец)\n603:     if ws2.max_row > 22:\n604:         ws2.delete_rows(23, ws2.max_row - 22)\n605: \n606:     # 2) Подпись ВЕТКИ 1 над таблицей в свободной ячейке справа (не сдвигаем строки)\n607:     _set(ws2, 1, cfg.scount + 2, \"ВЕТКА 1 — ЗАДАНЫ ОБЪЁМЫ (выпаривание): \"\n608:          \"% отгона → T1/T2 → поправка давления → T_corr (приведена к 760). \"\n609:          \"Ввод: T1/T2 и объёмы в «Ввод» (зелёные ячейки), Ввод!$G$1 = объём образца, мл.\",\n610:          fill=FILL_BRANCH, bold=True)\n611: \n612:     # 3) ВЕТКА 2 (независимая, «заданы температуры») — ввод T_НД и объёмов двух параллелей\n613:     nxt = build_branch2(ws2, cfg, start_row=BRANCH2_START)\n614: \n615:     # 4) Полиномиальная аппроксимация Ветки 1\n616:     nxt = build_poly_fit(ws2, cfg, start_row=nxt + 1)\n617: \n618:     # 5) ВТОРАЯ модель (Ветка 2) — полином по фактическим точкам (Vср → T_НД)\n619:     nxt = build_poly_fit_branch2(ws2, cfg, start_row=nxt + 1)\n620: \n621:     # 6) График: ДВЕ диаграммы (+ вспомогательные колонки без пустот)\n622:     rebuild_chart(wb, cfg, cfg.tag)\n623: \n624:     wb.save(out_path)\n625:     return True, (f\"{std}: ветки разделены, 2 модели (полиномы), \"\n626:                   f\"2 графика (Ветка 1: {N_PTS} точек; Ветка 2: фактические точки Vср→T_НД)\")\n627: \n628: \n629: def process_dir(src_dir: str, out_dir: str) -> None:\n630:     os.makedirs(out_dir, exist_ok=True)\n631:     files = sorted(f for f in os.listdir(src_dir) if f.lower().endswith(\".xlsx\"))\n632:     if not files:\n633:         logger.warning(\"Нет xlsx-файлов в %s\", src_dir)\n634:         return\n635:     for f in files:\n636:         src = os.path.join(src_dir, f)\n637:         dst = os.path.join(out_dir, f)\n638:         ok, msg = process_book(src, dst)\n639:         if ok:\n640:             logger.info(\"✓ %s — %s\", f, msg)\n641:         else:\n642:             logger.error(\"✗ %s — %s\", f, msg)\n643: \n644: \n645: def main() -> int:\n646:     here = os.path.dirname(os.path.abspath(__file__))\n647:     src_dir = os.path.join(here, \"new_versions_v3_11\")\n648:     out_dir = os.path.join(here, \"new_versions_v4\")\n649:     if \"--in\" in sys.argv:\n650:         src_dir = sys.argv[sys.argv.index(\"--in\") + 1]\n651:     if \"--out\" in sys.argv:\n652:         out_dir = sys.argv[sys.argv.index(\"--out\") + 1]\n653:     logger.info(\"Вход:  %s\", src_dir)\n654:     logger.info(\"Выход: %s\", out_dir)\n655:     process_dir(src_dir, out_dir)\n656:     logger.info(\"Готово. Реструктурированные книги в %s\", out_dir)\n657:     return 0\n658: \n659: \n660: if __name__ == \"__main__\":\n661:     sys.exit(main())"}], "metadata": {"truncated": false}}, "time": {"created": 1791912169188, "ran": 1791912169210, "completed": 1791912169255}}], "snapshot": {"start": "72ff983820157877c626134f7e479afabe0c662d", "end": "72ff983820157877c626134f7e479afabe0c662d", "files": []}, "finish": "tool-calls", "providerState": {"responseId": "resp_0f05ab37e548106a016ace68e8570887d2b2ac7c7d5e084358", "serviceTier": "default"}, "cost": 0, "tokens": {"input": 11064, "output": 292, "reasoning": 107, "cache"