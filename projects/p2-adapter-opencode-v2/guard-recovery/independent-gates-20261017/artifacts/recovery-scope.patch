+def configured_provider_names(cfg):
+    """Configured HTTP routes only; this does not probe their availability.
+
+    Legacy, explicitly listed providers may omit enabled/transport. An absent
+    provider never creates an implicit route. Native or unknown transports must
+    not silently fall back to the built-in HTTP endpoint.
+    """
+    providers = cfg.get('providers', {})
+    if not isinstance(providers, dict) or set(providers) - {'cloud', 'fallback', 'local'}:
+        raise ConfigError('providers_invalid')
+    names = []
+    for name in ('cloud', 'fallback', 'local'):
+        provider = providers.get(name)
+        if provider is None:
+            continue
+        if not isinstance(provider, dict):
+            raise ConfigError('provider_invalid')
+        enabled = provider.get('enabled', bool(provider))
+        transport = provider.get('transport', 'http')
+        if type(enabled) is not bool or not isinstance(transport, str):
+            raise ConfigError('provider_flags_invalid')
+        if not enabled or transport == 'unavailable':
+            continue
+        if transport != 'http':
+            raise ConfigError('provider_transport_unsupported')
+        names.append(name)
+    return tuple(names)
+
