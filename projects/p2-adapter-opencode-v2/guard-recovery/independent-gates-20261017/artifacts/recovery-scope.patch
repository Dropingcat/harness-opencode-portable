+@dataclass(frozen=True)
+class ClassificationReply:
+    """Explicit classifier answer plus transport provenance, not a host API DTO.
+
+    Completion metadata alone is never a classification. The future host
+    boundary must supply the actual response text to from_response(); raw text
+    is not retained in the result or tracker. Structural validity is not proof
+    of host authenticity.
+    """
+
+    message: HostMessage
+    verdict: str
+
+    def __post_init__(self):
+        if not isinstance(self.message, HostMessage):
+            raise TransportError('classification_message_invalid')
+        if not isinstance(self.verdict, str) or self.verdict not in ('YES', 'NO'):
+            raise TransportError('classification_verdict_invalid')
+
+    @classmethod
+    def from_response(cls, message, text):
+        if not isinstance(text, str) or len(text) > 32 or text.strip() not in ('YES', 'NO'):
+            raise TransportError('classification_response_invalid')
+        return cls(message=message, verdict=text.strip())
