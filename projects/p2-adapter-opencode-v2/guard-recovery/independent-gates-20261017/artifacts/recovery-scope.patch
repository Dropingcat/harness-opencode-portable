+"""Synthetic component checks; not evidence of trusted host execution."""
+from concurrent.futures import ThreadPoolExecutor
+from dataclasses import replace
+import hashlib
+import json
+from pathlib import Path
+import sys
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / 'guard/src'))
+import opencode_transport as transport
+from native_semantic_transport import NativeAdapter, NativeTransportChain
+from semantic_layer import Budget
+import artifact_guard
+
+
+CHUNK = 'Synthetic classifier input.'
+
+
+def snapshot(parent_id='ses_parent_a'):
+    model = transport.ModelRef('component-provider', 'component-model')
+    parent = transport.ParentContext(parent_id, model=model)
+    return transport.RequestSnapshot('ses_component_child', parent,
+                                     hashlib.sha256(CHUNK.encode()).hexdigest(), model)
+
+
+def message(bound, message_id='msg_1', request_hash=True):
+    return transport.HostMessage('assistant', bound.request_id, message_id,
+                                 bound.model, 'stop',
+                                 bound.input_sha256 if request_hash else None)
+
+
+def reply(bound, verdict, message_id='msg_1', request_hash=True):
+    return transport.ClassificationReply.from_response(
+        message(bound, message_id, request_hash), verdict)
+
+
+class NativeClassifierRecoveryTests(unittest.TestCase):
+    def test_transport_completion_alone_is_not_a_clean_classification(self):
+        bound = snapshot()
+        adapter = NativeAdapter(lambda *args: message(bound))
+        report = adapter.classify(CHUNK, bound)
+        self.assertIsNone(report['verdict'])
+        self.assertEqual('CRITICAL', report['alarm_level'])
+
+    def test_classification_parser_rejects_missing_or_ambiguous_response(self):
+        bound = snapshot()
+        for text in (None, '', 'yes', 'NO but also YES', 'The result is NO', {'verdict': 'NO'}):
+            with self.subTest(text=text), self.assertRaises(transport.TransportError):
+                reply(bound, text)
+        self.assertEqual('NO', reply(bound, ' NO\n').verdict)
+
+    def test_three_unique_explicit_no_replies_can_form_component_majority(self):
+        calls = []
+        def classify(chunk, bound, vote_index):
+            calls.append((chunk, bound, vote_index))
+            return reply(bound, 'NO', 'msg_' + str(vote_index))
+        report = NativeAdapter(classify).classify(CHUNK, snapshot())
+        self.assertEqual('NO', report['verdict'])
+        self.assertEqual({'yes': 0, 'no': 3, 'timeout': 0}, report['votes'])
+        self.assertEqual(3, len(calls))
+        self.assertEqual([0, 1, 2], [call[2] for call in calls])
+
+    def test_explicit_yes_is_not_converted_to_no(self):
+        adapter = NativeAdapter(lambda chunk, bound, vote: reply(bound, 'YES', 'msg_' + str(vote)))
+        report = adapter.classify(CHUNK, snapshot())
+        self.assertEqual('YES', report['verdict'])
+        self.assertEqual({'yes': 3, 'no': 0, 'timeout': 0}, report['votes'])
+
+    def test_repeating_one_message_does_not_manufacture_three_votes(self):
+        bound = snapshot()
+        cached_reply = reply(bound, 'NO')
+        report = NativeAdapter(lambda *args: cached_reply).classify(CHUNK, bound)
+        self.assertIsNone(report['verdict'])
+        self.assertEqual({'yes': 0, 'no': 1, 'timeout': 2}, report['votes'])
+
+    def test_missing_request_hash_cannot_pass(self):
+        adapter = NativeAdapter(lambda chunk, bound, vote: reply(bound, 'NO', 'msg_' + str(vote), False))
+        self.assertIsNone(adapter.classify(CHUNK, snapshot())['verdict'])
+
+    def test_foreign_session_model_and_nonterminal_replies_cannot_pass(self):
+        bound = snapshot()
+        for changes in ({'session_id': 'ses_foreign'},
+                        {'model': transport.ModelRef('other-provider', 'other-model')},
+                        {'finish': None}, {'finish': 'length'},
+                        {'request_hash': 'different-input'}):
+            with self.subTest(changes=changes):
+                wrong = replace(message(bound), **changes)
+                adapter = NativeAdapter(lambda *args: transport.ClassificationReply(wrong, 'NO'))
+                self.assertIsNone(adapter.classify(CHUNK, bound)['verdict'])
+
+    def test_adapter_exception_is_refusal_and_does_not_leak_details(self):
+        def broken(*args):
+            raise RuntimeError('synthetic-secret-do-not-log')
+        report = NativeAdapter(broken).classify(CHUNK, snapshot())
+        self.assertIsNone(report['verdict'])
+        self.assertNotIn('synthetic-secret', json.dumps(report))
+
+    def test_snapshot_must_describe_the_actual_chunk(self):
+        calls = []
+        adapter = NativeAdapter(lambda *args: calls.append(args))
+        self.assertIsNone(adapter.classify(CHUNK + 'changed', snapshot())['verdict'])
+        self.assertEqual([], calls)
+
+    def test_existing_majority_rule_is_preserved(self):
+        for values, expected in ((('NO', 'NO', 'YES'), 'NO'),
+                                 (('YES', 'NO', 'YES'), 'YES'),
+                                 (('NO', 'YES', None), None)):
+            def classify(chunk, bound, vote):
+                return None if values[vote] is None else reply(bound, values[vote], 'msg_' + str(vote))
+            self.assertEqual(expected, NativeAdapter(classify).classify(CHUNK, snapshot())['verdict'])
+
+    def test_parallel_parents_and_repeated_inputs_have_distinct_component_requests(self):
+        def run(parent_id):
+            seen = []
+            def classify(chunk, bound, vote):
+                seen.append((bound.parent.parent_id, bound.request_id))
+                return reply(bound, 'NO', 'msg_' + str(vote))
+            parent = snapshot(parent_id).parent
+            chain = NativeTransportChain({}, Budget(0), parent=parent, adapter_chain=classify)
+            self.assertEqual('NO', chain.run(CHUNK)['verdict'])
+            self.assertEqual('NO', chain.run(CHUNK)['verdict'])
+            return seen
+        with ThreadPoolExecutor(2) as pool:
+            a, b = list(pool.map(run, ['ses_parent_a', 'ses_parent_b']))
+        self.assertEqual({'ses_parent_a'}, {p for p, _ in a})
+        self.assertEqual({'ses_parent_b'}, {p for p, _ in b})
+        ids_a, ids_b = {i for _, i in a}, {i for _, i in b}
+        self.assertEqual(2, len(ids_a))
+        self.assertEqual(2, len(ids_b))
+        self.assertTrue(ids_a.isdisjoint(ids_b))
+
+    def test_scanner_consumes_native_classification_not_completion_metadata(self):
+        with tempfile.TemporaryDirectory() as folder:
+            path, config = Path(folder) / 'synthetic.txt', Path(folder) / 'config.json'
+            path.write_text(CHUNK * 400, encoding='utf-8')
+            config.write_text('{"budget":{"max_cost_rub":0}}', encoding='utf-8')
+            for verdict in ('YES', 'NO'):
+                def classify(chunk, bound, vote):
+                    return reply(bound, verdict, 'msg_' + str(vote))
+                def factory(cfg, budget):
+                    return NativeTransportChain(cfg, budget, parent=snapshot().parent,
+                                                adapter_chain=classify)
+                report = artifact_guard.scan_artifact(path, config=config, chain_factory=factory)
+                self.assertEqual('testing_only_not_host_certification', report['evidence'])
+                self.assertEqual(verdict == 'NO', report['ok'])
+                if verdict == 'YES':
+                    self.assertEqual('p2_injection', report['reason'])
+                    self.assertFalse(report['coverage']['complete'])
+                else:
+                    self.assertTrue(report['coverage']['complete'])
+                    self.assertGreater(len(report['coverage']['ranges']), 1)
+
+
+if __name__ == '__main__':
+    unittest.main()
