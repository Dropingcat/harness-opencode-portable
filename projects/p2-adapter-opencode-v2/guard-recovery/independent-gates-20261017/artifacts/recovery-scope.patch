+++ b/tests/coder/test_guard_recovery.py
@@ -0,0 +1,154 @@
+"""Local recovery regressions. No live provider, credentials or host calls."""
+import json
+import os
+from pathlib import Path
+import subprocess
+import sys
+import tempfile
+import unittest
+from unittest.mock import patch
+
+ROOT = Path(__file__).resolve().parents[2]
+sys.path.insert(0, str(ROOT / 'guard/src'))
+import artifact_guard as guard
+import semantic_layer as semantic
+
+
+DISABLED = {'providers': {name: {'enabled': False, 'transport': 'unavailable'}
+                          for name in ('cloud', 'fallback', 'local')}}
+
+
+class GuardRecoveryTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory()
+        self.addCleanup(self.temp.cleanup)
+        self.artifact = Path(self.temp.name) / 'synthetic.txt'
+        self.artifact.write_text('Synthetic technical description.', encoding='utf-8')
+        self.config = Path(self.temp.name) / 'config.json'
+        self.config.write_text(json.dumps(DISABLED), encoding='utf-8')
+
+    def test_disabled_providers_are_not_constructed(self):
+        with patch.object(semantic, '_cloud_from_cfg') as cloud, \
+                patch.object(semantic, '_local_from_cfg') as local:
+            chain = semantic.ClassifierChain(DISABLED, semantic.Budget(1))
+        cloud.assert_not_called()
+        local.assert_not_called()
+        self.assertIsNone(chain.cloud_primary)
+        self.assertIsNone(chain.cloud_fallback)
+        self.assertIsNone(chain.local)
+        self.assertIsNone(chain.run('synthetic')['verdict'])
+
+    def test_missing_providers_do_not_create_implicit_local_route(self):
+        with patch.object(semantic, '_local_from_cfg') as local:
+            chain = semantic.ClassifierChain({}, semantic.Budget(1))
+        local.assert_not_called()
+        self.assertIsNone(chain.local)
+
+    def test_unavailable_transport_is_not_reinterpreted_as_http(self):
+        cfg = {'providers': {'cloud': {'enabled': True, 'transport': 'unavailable'}}}
+        with patch.object(semantic, '_cloud_from_cfg') as cloud:
+            semantic.ClassifierChain(cfg, semantic.Budget(1))
+        cloud.assert_not_called()
+
+    def test_invalid_enabled_or_unknown_transport_is_refused(self):
+        for provider in ({'enabled': 'false'}, {'enabled': 0},
+                         {'enabled': True, 'transport': 'unknown'},
+                         {'enabled': True, 'transport': None}):
+            with self.subTest(provider=provider), self.assertRaises(semantic.ConfigError):
+                semantic.ClassifierChain({'providers': {'cloud': provider}}, semantic.Budget(1))
+
+    def test_legacy_explicit_provider_without_enabled_flag_is_preserved(self):
+        cfg = {'providers': {'cloud': {'model': 'synthetic-model'}}}
+        with patch.object(semantic, '_cloud_from_cfg', return_value=object()) as cloud, \
+                patch.object(semantic, '_local_from_cfg') as local:
+            chain = semantic.ClassifierChain(cfg, semantic.Budget(1))
+        cloud.assert_called_once()
+        local.assert_not_called()
+        self.assertIsNotNone(chain.cloud_primary)
+
+    def test_scanner_blocks_unconfigured_p2_without_starting_worker(self):
+        with patch.object(guard, '_bounded_p2', side_effect=AssertionError('must not spawn')):
+            report = guard.scan_artifact(self.artifact, config=self.config)
+        self.assertEqual('p2_not_configured', report['reason'])
+        self.assertEqual(['P0'], report['executed_stages'])
+        self.assertEqual('BLOCK', report['verdict'])
+        self.assertFalse(report['coverage']['complete'])
+        self.assertFalse(report['ok'])
+
+    def test_preflight_exposes_missing_route_but_never_grants_admission(self):
+        report = guard.preflight(config=self.config)
+        self.assertTrue(report['readiness'])
+        self.assertFalse(report['p2_configured'])
+        self.assertEqual([], report['configured_providers'])
+        self.assertFalse(report['ok'])
+        self.assertEqual('READINESS', report['verdict'])
+        self.assertFalse(report['provider_availability_verified'])
+
+    def test_configured_deadline_is_used_and_cli_can_only_tighten_it(self):
+        self.config.write_text(json.dumps({'security': {'timeout_sec': 0.5}}), encoding='utf-8')
+        for requested, expected in ((None, 0.5), (0.1, 0.1), (2.0, 0.5)):
+            with self.subTest(requested=requested), \
+                    patch.object(guard, '_bounded_p2', return_value={'reason': 'timeout', 'ranges': []}) as worker:
+                report = guard.scan_artifact(self.artifact, config=self.config,
+                                             timeout=requested, chain_factory=object())
+            self.assertEqual(expected, worker.call_args.args[-1])
+            self.assertEqual(expected, report['timeout_seconds'])
+            self.assertEqual('timeout', report['reason'])
+            self.assertFalse(report['ok'])
+
+    def test_invalid_deadlines_are_structured_blocks(self):
+        for value in (0, -1, float('nan'), float('inf'), True, guard.MAX_TIMEOUT + 1):
+            with self.subTest(value=value):
+                report = guard.scan_artifact(self.artifact, config=self.config, timeout=value)
+                self.assertEqual('timeout_invalid', report['reason'])
+                self.assertFalse(report['ok'])
+
+    def test_cli_disabled_config_returns_json_promptly_with_explicit_deadline(self):
+        env = dict(os.environ, OPENCODE_HARNESS_ROOT=str(ROOT))
+        proc = subprocess.run(
+            [sys.executable, str(ROOT / 'scripts/tools/doc_guard.py'), 'scan',
+             '--artifact', str(self.artifact), '--config', str(self.config),
+             '--timeout', '0.1', '--json'],
+            capture_output=True, text=True, encoding='utf-8', env=env, timeout=10)
+        self.assertEqual(1, proc.returncode, proc.stderr)
+        report = json.loads(proc.stdout)
+        self.assertEqual('p2_not_configured', report['reason'])
+        self.assertFalse(report['ok'])
+        self.assertEqual([], report['coverage']['ranges'])
+
+    def test_cli_invalid_deadline_is_a_json_block_not_a_traceback(self):
+        env = dict(os.environ, OPENCODE_HARNESS_ROOT=str(ROOT))
+        proc = subprocess.run(
+            [sys.executable, str(ROOT / 'scripts/tools/doc_guard.py'), 'scan',
+             '--artifact', str(self.artifact), '--config', str(self.config),
+             '--timeout', 'nan', '--json'],
+            capture_output=True, text=True, encoding='utf-8', env=env, timeout=10)
+        self.assertEqual(1, proc.returncode)
+        self.assertEqual('timeout_invalid', json.loads(proc.stdout)['reason'])
+        self.assertNotIn('Traceback', proc.stdout + proc.stderr)
+
+    def test_provider_config_validation_cannot_be_bypassed_by_fixture_chain(self):
+        self.config.write_text(json.dumps({'providers': {'cloud': {'enabled': 'false'}}}), encoding='utf-8')
+        with patch.object(guard, '_bounded_p2') as worker:
+            report = guard.scan_artifact(self.artifact, config=self.config, chain_factory=object())
+        worker.assert_not_called()
+        self.assertFalse(report['ok'])
+
+    def test_timeout_terminates_owned_worker_and_closes_pipe(self):
+        from unittest.mock import Mock
+        receiver, sender, process, context = Mock(), Mock(), Mock(), Mock()
+        context.Pipe.return_value = (receiver, sender)
+        context.Process.return_value = process
+        receiver.poll.return_value = False
+        process.is_alive.return_value = True
+        with patch.object(guard.multiprocessing, 'get_context', return_value=context):
+            result = guard._bounded_p2('synthetic', DISABLED, None, 0.01)
+        self.assertEqual({'reason': 'timeout', 'ranges': []}, result)
+        receiver.poll.assert_called_once_with(0.01)
+        process.terminate.assert_called_once()
+        receiver.close.assert_called_once()
+        self.assertTrue(sender.close.called)
+
+
+if __name__ == '__main__':
+    unittest.main()
