{
  "version": 1,
  "claim_kinds": {
    "requirement": {
      "match_regex": "(?i)^(add|implement|support|need|must|нужно|сделай|добавь)"
    },
    "code_change": {
      "match_regex": "(?i)(refactor|fix|change code|patch|исправ|рефактор|правка)"
    },
    "interface": {
      "match_regex": "(?i)(api|interface|contract|schema|endpoint|интерфейс|контракт|схема)"
    },
    "test": {
      "match_regex": "(?i)(test|pytest|coverage|smoke|проверь|тест)"
    },
    "factual": {
      "match_regex": "(?i)(fact|claim|is it true|правда|факт|утверждение)"
    },
    "evidence": {
      "match_regex": "(?i)(evidence|source|paper|doi|citation|источник|доказатель|статья)"
    },
    "config": {
      "match_regex": "(?i)(config|plugin|mcp|env|setting|конфиг|плагин|настройк)"
    },
    "security": {
      "match_regex": "(?i)(security|guard|injection|secret|безопас|инъекц|секрет)"
    },
    "performance": {
      "match_regex": "(?i)(performance|speed|latency|memory|benchmark|ускор|производит|латент|памят)"
    },
    "docs": {
      "match_regex": "(?i)(docs|readme|document|описать|документ|readme)"
    },
    "unresolved_question": {
      "match_regex": "(?i)(\\?|unclear|not sure|неясно|вопрос)"
    }
  }
}
