    "research_web": {
      "kind": "launcher",
      "entrypoint": "mcp/launchers/opencode_research_web.py",
      "provider": "opencode_research_web"
    },
    "service_task": {
      "kind": "launcher",
      "entrypoint": "mcp/launchers/opencode_service_task.py",
      "provider": "opencode_service_task"
    },
    "profile_config": {
      "kind": "launcher",
      "entrypoint": "mcp/launchers/opencode_profile_configurator.py",
      "provider": "opencode_profile_configurator"
    },
    "arxiv_search": {
